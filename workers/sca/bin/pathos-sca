#!/usr/local/bin/python3 -I
"""Runs a worker-sca tool on a repository checkout for its tool manifest.

    pathos-sca <tool> --version
    pathos-sca <tool> <source> <output> [<cache>]

Finds the files the tool reads (lockfiles, requirement files, modules),
runs the tool on each with options that keep it from running repository
code (no package-manager plugins, scripts, toolchain or package-manager
version switching), and writes one report in the tool's own format to
<output> (an empty file means nothing to scan).

Tools that read one lockfile or requirements file at a time (npm, yarn,
pnpm and Composer audit, pip-audit) run once per file found anywhere in
the repository (outside node_modules, vendor and the other SKIP_DIRS), and
their reports are written in a PATHOS envelope:

    {"pathos_reports": [{"file": "<path in the repository>", "report": <the tool's JSON>}
                        or {"file": ..., "report_text": "<the tool's JSON Lines>"}, ...]}

which the PATHOS import parsers read: each finding is located in the file
its report came from. govulncheck runs once per Go module and records the
module's directory in each run's config message (pathos_module_dir).

Exit status: 0 when every run succeeded (a tool's "vulnerabilities found"
status is success), 3 when any run failed; the reports of the runs that
succeeded are still written, and the last line on standard error says
which runs failed and why (the worker shows it as the tool's error).
"""

import json
import os
import re
import shutil
import subprocess
import sys

# Optional operator settings. The worker passes tools a scrubbed environment
# (PATH, proxy and locale variables only), so registry and NVD settings come
# from a file the operator mounts read-only: KEY=VALUE lines; only the keys
# below are read, everything else is ignored.
SETTINGS_FILE = "/etc/pathos/sca.env"
SETTINGS_KEYS = {"NVD_API_KEY", "NVD_DATAFEED_URL", "GOPROXY", "GOVULNDB", "NPM_CONFIG_REGISTRY"}


def load_settings(path=SETTINGS_FILE):
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read(64 << 10).splitlines()
    except OSError:
        return
    for line in lines:
        key, sep, value = line.strip().partition("=")
        key, value = key.strip(), value.strip().strip('"').strip("'")
        if sep and key in SETTINGS_KEYS and value:
            os.environ.setdefault(key, value)


load_settings()

SCA = "/opt/pathos/sca"
BIN = SCA + "/bin"
NODE = SCA + "/node/bin/node"
NPM_BIN = SCA + "/npm/node_modules/.bin"
SKIP_DIRS = {".git", "node_modules", "vendor", ".venv", "venv", "site-packages", "bower_components", ".tox", "testdata", "target"}
# GuardDog's popular-package lists, never refreshed (see the Dockerfile).
GUARDDOG_ENV = {"GUARDDOG_TOP_PACKAGES_CACHE_LOCATION": SCA + "/guarddog-top"}
NPM_REGISTRY = os.environ.get("NPM_CONFIG_REGISTRY") or "https://registry.npmjs.org/"


def log(msg):
    print("pathos-sca: " + msg, file=sys.stderr, flush=True)


def find(src, match, limit=200):
    """Repository files whose name satisfies match (sorted, at most limit)."""
    out = []
    for root, dirs, files in os.walk(src):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)
        for f in sorted(files):
            if match(f):
                out.append(os.path.join(root, f))
                if len(out) >= limit:
                    return out
    return out


def run(args, cwd=None, env=None, ok=(0,), stdout=None):
    """Runs a command (no shell); returns its exit status or None on failure."""
    e = dict(os.environ)
    e.update(env or {})
    try:
        p = subprocess.run(args, cwd=cwd, env=e, stdout=stdout, stdin=subprocess.DEVNULL)
    except OSError as err:
        log("%s: %s" % (args[0], err))
        return None
    if p.returncode not in ok:
        log("%s exited with status %d" % (os.path.basename(args[0]), p.returncode))
        return None
    return p.returncode


def capture(args, **kw):
    """Runs a command and returns its standard output, or None."""
    r = subprocess.run(args, capture_output=True, stdin=subprocess.DEVNULL, **kw)
    if r.returncode != 0:
        sys.stderr.write(r.stderr.decode(errors="replace"))
    return r


def rel(src, path):
    return os.path.relpath(path, src)


def write(out, data):
    with open(out, "wb") as f:
        f.write(data)


def finish(runs, failures):
    """Exit status of a tool: 0 when nothing failed, else 3 with a summary
    of the failures as the last line of standard error."""
    if not failures:
        return 0
    first = failures[0]
    more = "" if len(failures) == 1 else " (and %d more)" % (len(failures) - 1)
    log("%d of %d runs failed: %s%s" % (len(failures), len(failures) + runs, first, more))
    return 3


def last_error(stderr, stdout=b""):
    """The most useful line of a failed tool's output."""
    text = re.sub(r"\x1b\[[0-9;]*m", "", (stderr or b"").decode(errors="replace"))
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    errs = [l for l in lines if "error" in l.lower()]
    line = (errs or lines or [""])[-1]
    if not line and stdout:
        line = stdout.decode(errors="replace").strip().splitlines()[-1] if stdout.strip() else ""
    return line[:300] or "no output"


def json_or_none(data):
    try:
        return json.loads(data)
    except ValueError:
        return None


def per_file(src, out, files, audit):
    """Runs audit(path) -> (report or None, report_text or None, error or
    None) on every file and writes the PATHOS envelope."""
    reports, failures = [], []
    for path in files:
        log("%s" % rel(src, path))
        report, text, err = audit(path)
        if err:
            failures.append("%s: %s" % (rel(src, path), err))
            continue
        entry = {"file": rel(src, path)}
        if text is not None:
            entry["report_text"] = text
        else:
            entry["report"] = report
        reports.append(entry)
    write(out, json.dumps({"pathos_reports": reports}).encode() if reports else b"")
    return finish(len(reports), failures)


# --- tools -------------------------------------------------------------------


def govulncheck(src, out, cache):
    """govulncheck -format json on every Go module (call-graph reachability).
    Modules and the vulnerability database are downloaded through the egress
    proxy (GOPROXY, default https://proxy.golang.org; https://vuln.go.dev)."""
    mods = [os.path.dirname(p) for p in find(src, lambda f: f == "go.mod")]
    env = {
        "PATH": SCA + "/go/bin:" + os.environ.get("PATH", "/usr/bin:/bin"),
        "GOROOT": SCA + "/go",
        "GOTOOLCHAIN": "local",  # never download another toolchain
        "CGO_ENABLED": "0",  # package loading runs no C compiler
        "GOFLAGS": "-mod=readonly -buildvcs=false",
        "GOENV": "off",
        "GOPATH": os.path.join(cache, "gopath"),
        "GOMODCACHE": os.path.join(cache, "gopath", "pkg", "mod"),
        "GOCACHE": os.path.join(cache, "build"),
        "GOPROXY": os.environ.get("GOPROXY") or "https://proxy.golang.org",
    }
    db = os.environ.get("GOVULNDB") or "https://vuln.go.dev"
    runs, failures = 0, []
    with open(out, "wb") as f:
        for m in mods:
            d = rel(src, m)
            log("govulncheck " + d)
            r = capture([BIN + "/govulncheck", "-db", db, "-C", m, "-format", "json", "./..."], env={**os.environ, **env})
            if r.returncode == 0:
                f.write(govulncheck_with_dir(r.stdout, "" if d == "." else d))
                runs += 1
            else:
                failures.append("%s: %s" % (d, last_error(r.stderr)))
    return finish(runs, failures)


def govulncheck_with_dir(stream, moddir):
    """govulncheck's JSON message stream, one message per line, with the
    module's directory in the config message."""
    dec, i, out = json.JSONDecoder(), 0, []
    text = stream.decode(errors="replace")
    while True:
        while i < len(text) and text[i].isspace():
            i += 1
        if i >= len(text):
            break
        msg, i = dec.raw_decode(text, i)
        if isinstance(msg, dict) and isinstance(msg.get("config"), dict):
            msg["config"]["pathos_module_dir"] = moddir
        out.append(json.dumps(msg))
    return ("\n".join(out) + "\n").encode() if out else b""


def pip_audit(src, out, cache):
    """pip-audit on every requirements*.txt (pinned requirements; no pip, no
    dependency resolution). Vulnerability data: PyPI (https://pypi.org)."""
    reqs = find(src, lambda f: f.startswith("requirements") and f.endswith(".txt"))
    if not reqs:
        write(out, b"")
        return 0
    # pip is not installed: pip-audit reads a pip version from pip-version.
    env = {**os.environ, "PIPAPI_PYTHON_LOCATION": BIN + "/pip-version"}
    tmp = out + ".pip-audit.json"

    # One run per file: pip-audit refuses a package pinned in two files of
    # one run, and its exit status 1 means both "vulnerabilities found" and
    # "error"; only a JSON report counts as success.
    def audit(req):
        if os.path.exists(tmp):
            os.remove(tmp)
        r = capture([SCA + "/bin/pip-audit", "--disable-pip", "--no-deps", "--progress-spinner", "off", "-f", "json", "-o", tmp,
                     "--cache-dir", os.path.join(cache, "pip-audit"), "-r", req], env=env)
        rep = None
        if r.returncode in (0, 1) and os.path.exists(tmp):
            with open(tmp, "rb") as f:
                rep = json_or_none(f.read())
        if not isinstance(rep, dict) or "dependencies" not in rep:
            return None, None, "pip-audit exited with %d: %s" % (r.returncode, last_error(r.stderr))
        return rep, None, None

    try:
        return per_file(src, out, reqs, audit)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def cargo_audit(src, out, cache):
    """cargo-audit on every Cargo.lock with the bundled RustSec database
    (offline)."""
    reports, failures = [], []
    for lock in find(src, lambda f: f == "Cargo.lock"):
        r = capture([BIN + "/cargo-audit", "audit", "--db", SCA + "/db/advisory-db", "--no-fetch", "--stale", "--json",
                     "--file", lock])
        rep = json_or_none(r.stdout)
        if isinstance(rep, dict):
            reports.append(rep)
        else:
            failures.append("%s: cargo-audit exited with %d: %s" % (rel(src, lock), r.returncode, last_error(r.stderr)))
    if not reports:
        write(out, b"")
        return finish(0, failures)
    merged = reports[0]
    for rep in reports[1:]:
        v = merged.setdefault("vulnerabilities", {"found": False, "count": 0, "list": []})
        rv = rep.get("vulnerabilities") or {}
        v["list"] = (v.get("list") or []) + (rv.get("list") or [])
        v["count"] = len(v["list"])
        v["found"] = bool(v["list"])
        w = merged.setdefault("warnings", {})
        for kind, items in (rep.get("warnings") or {}).items():
            w[kind] = (w.get(kind) or []) + (items or [])
    write(out, json.dumps(merged).encode())
    return finish(len(reports), failures)


def bundler_audit(src, out, cache):
    """bundler-audit on every Gemfile.lock with the bundled Ruby advisory
    database (offline)."""
    env = {"BUNDLE_GEMFILE": "/nonexistent/Gemfile"}
    reports, failures = [], []
    for lock in find(src, lambda f: f == "Gemfile.lock"):
        r = capture(["/usr/local/bin/bundle-audit", "check", "--no-update", "--database", SCA + "/db/ruby-advisory-db",
                     "--format", "json", "--gemfile-lock", os.path.basename(lock), os.path.dirname(lock)],
                    env={**os.environ, **env})
        rep = json_or_none(r.stdout)
        if isinstance(rep, dict):
            reports.append(rep)
        else:
            failures.append("%s: bundle-audit exited with %d: %s" % (rel(src, lock), r.returncode, last_error(r.stderr)))
    if not reports:
        write(out, b"")
        return finish(0, failures)
    merged = reports[0]
    for rep in reports[1:]:
        merged["results"] = (merged.get("results") or []) + (rep.get("results") or [])
    write(out, json.dumps(merged).encode())
    return finish(len(reports), failures)


def retire(src, out, cache):
    """Retire.js on the JavaScript files of the repository with the bundled
    Retire.js repository (offline)."""
    args = [NODE, NPM_BIN + "/retire", "--path", src, "--outputformat", "json", "--outputpath", out,
            "--jsrepo", SCA + "/db/jsrepository.json", "--exitwith", "0", "--ignore", "node_modules"]
    return 0 if run(args) is not None else 3


def node_env():
    return {"PATH": SCA + "/node/bin:" + os.environ.get("PATH", "/usr/bin:/bin"),
            "npm_config_update_notifier": "false", "npm_config_fund": "false",
            # yarn 1: never run the yarn release a repository's .yarnrc names.
            "YARN_IGNORE_PATH": "1", "COREPACK_ENABLE_STRICT": "0"}


def lockfiles(src, *names):
    """Every lockfile with one of names in the repository (outside
    SKIP_DIRS); in a directory with several, the first name wins."""
    seen, out = set(), []
    for p in find(src, lambda f: f in names):
        d = os.path.dirname(p)
        if d not in seen:
            seen.add(d)
            out.append(p)
    return out


def tool_json(r, ok_codes, valid):
    """A run's JSON report, or an error: exit status in ok_codes and a
    report for which valid(report) is true."""
    rep = json_or_none(r.stdout)
    if r.returncode in ok_codes and isinstance(rep, dict) and valid(rep):
        return rep, None, None
    err = ""
    if isinstance(rep, dict) and rep.get("error"):
        e = rep["error"]
        err = e.get("summary") or e.get("message") or e.get("code") if isinstance(e, dict) else str(e)
    return None, None, "exited with %d: %s" % (r.returncode, (str(err)[:300] if err else last_error(r.stderr, r.stdout)))


def npm_audit(src, out, cache):
    """npm audit of every package-lock.json (or npm-shrinkwrap.json) in the
    repository (npm's audit endpoint of registry.npmjs.org, or
    NPM_CONFIG_REGISTRY). Exit status 1 means vulnerabilities were found;
    a report without "vulnerabilities" (npm's error JSON) is a failure."""
    def audit(lock):
        r = capture([NODE, SCA + "/npm/node_modules/npm/bin/npm-cli.js", "audit", "--json", "--package-lock-only",
                     "--ignore-scripts", "--registry", NPM_REGISTRY, "--cache", os.path.join(cache, "npm")],
                    cwd=os.path.dirname(lock), env={**os.environ, **node_env()})
        return tool_json(r, (0, 1), lambda rep: "vulnerabilities" in rep or "advisories" in rep)
    return per_file(src, out, lockfiles(src, "npm-shrinkwrap.json", "package-lock.json"), audit)


def yarn_audit(src, out, cache):
    """yarn audit (Yarn 1) of every yarn.lock. Yarn 2+ lockfiles are
    skipped (Yarn 2+ runs the release committed in the repository)."""
    def audit(lock):
        # Exit status: a bit mask of the severities found (0-31). Success
        # is an auditSummary line in the JSON Lines output.
        r = capture([NODE, NPM_BIN + "/yarn", "audit", "--json", "--non-interactive", "--ignore-engines", "--registry", NPM_REGISTRY,
                     "--cache-folder", os.path.join(cache, "yarn")], cwd=os.path.dirname(lock), env={**os.environ, **node_env()})
        text = r.stdout.decode(errors="replace")
        types = [(json_or_none(l) or {}).get("type") for l in text.splitlines() if l.strip()]
        if r.returncode < 32 and "auditSummary" in types:
            return None, text, None
        errs = [(json_or_none(l) or {}).get("data") for l in text.splitlines() if '"type":"error"' in l.replace(" ", "")]
        return None, None, "exited with %d: %s" % (r.returncode, str(errs[-1])[:300] if errs else last_error(r.stderr))
    locks = lockfiles(src, "yarn.lock")
    # Yarn 2+ lockfiles are not an error: they are skipped with a message.
    v1 = []
    for lock in locks:
        with open(lock, "rb") as f:
            if b"__metadata:" in f.read(4096):
                log("%s is a Yarn 2+ lockfile; yarn audit (Yarn 1) cannot read it" % rel(src, lock))
                continue
        v1.append(lock)
    return per_file(src, out, v1, audit)


def pnpm_audit(src, out, cache):
    """pnpm audit of every pnpm-lock.yaml (registry.npmjs.org)."""
    env = {**os.environ, **node_env(), "npm_config_manage_package_manager_versions": "false",
           "npm_config_store_dir": os.path.join(cache, "pnpm-store"), "XDG_CACHE_HOME": os.path.join(cache, "xdg")}

    def audit(lock):
        # Never download and run the pnpm version a package.json names.
        r = capture([NODE, NPM_BIN + "/pnpm", "audit", "--json", "--ignore-scripts", "--registry", NPM_REGISTRY],
                    cwd=os.path.dirname(lock), env=env)
        return tool_json(r, (0, 1), lambda rep: "advisories" in rep or "metadata" in rep)
    return per_file(src, out, lockfiles(src, "pnpm-lock.yaml"), audit)


def composer_audit(src, out, cache):
    """composer audit of every composer.lock (no plugins, no scripts;
    advisories from packagist.org)."""
    env = {**os.environ, "COMPOSER_HOME": os.path.join(cache, "composer"), "COMPOSER_CACHE_DIR": os.path.join(cache, "composer", "cache"),
           "COMPOSER_NO_INTERACTION": "1", "COMPOSER_ALLOW_SUPERUSER": "0", "COMPOSER_DISABLE_XDEBUG_WARN": "1"}

    def audit(lock):
        # Exit status: 1 vulnerable, 2 abandoned packages, 3 both.
        r = capture(["/usr/bin/php", SCA + "/composer.phar", "audit", "--locked", "--format=json", "--no-plugins", "--no-scripts",
                     "--no-interaction", "--working-dir", os.path.dirname(lock)], env=env)
        return tool_json(r, (0, 1, 2, 3), lambda rep: "advisories" in rep)
    return per_file(src, out, lockfiles(src, "composer.lock"), audit)


NVD_FEEDS = "https://nvd.nist.gov/feeds/json/cve/2.0/nvdcve-2.0-{0}.json.gz"


def dependency_check(src, out, cache):
    """OWASP Dependency-Check. The NVD data is downloaded into the cache
    (https://services.nvd.nist.gov); NVD_API_KEY (optional, from
    /etc/pathos/sca.env) uses the NVD API instead of the yearly data feeds. Analyzers that run package
    managers or contact other services are disabled."""
    args = [SCA + "/dependency-check/bin/dependency-check.sh", "--scan", src, "--format", "JSON", "--out", out,
            "--data", os.path.join(cache, "data"), "--project", "pathos",
            "--disableOssIndex", "--disableCentral", "--disableRetireJs", "--disableNodeAudit", "--disableYarnAudit",
            "--disablePnpmAudit", "--disableBundleAudit", "--disableGolangMod", "--disableMixAudit", "--disableAssembly",
            "--disableHostedSuppressions", "--disableKnownExploited", "--disableVersionCheck",
            "--exclude", "**/.git/**", "--exclude", "**/node_modules/**"]
    key = os.environ.get("NVD_API_KEY")
    env = {"JAVA_HOME": SCA + "/jre"}
    if key:
        args += ["--nvdApiKey", key]
    else:
        # Without an API key: the NVD's yearly JSON 2.0 data feeds
        # (https://nvd.nist.gov/feeds), or a mirror (NVD_DATAFEED_URL).
        args += ["--nvdDatafeed", os.environ.get("NVD_DATAFEED_URL") or NVD_FEEDS]
    os.makedirs(os.path.join(cache, "data"), exist_ok=True)
    return 0 if run(args, env=env) is not None else 3


def guarddog(src, out, cache):
    """GuardDog verify on every requirements*.txt and package.json: each
    dependency is downloaded from PyPI or npm and checked for malware
    heuristics (source code rules and metadata rules such as
    typosquatting). Nothing is installed or executed."""
    targets = [("pypi", p) for p in find(src, lambda f: f.startswith("requirements") and f.endswith(".txt"))]
    targets += [("npm", p) for p in find(src, lambda f: f == "package.json")]
    runs_out, failures = [], []
    base = None
    for eco, path in targets:
        r = capture([SCA + "/bin/guarddog", eco, "verify", path, "--output-format", "sarif"], env={**os.environ, **GUARDDOG_ENV})
        doc = json_or_none(r.stdout)
        if not isinstance(doc, dict):
            failures.append("%s: guarddog exited with %d: %s" % (rel(src, path), r.returncode, last_error(r.stderr)))
            continue
        base = base or doc
        for run_ in doc.get("runs") or []:
            for res in run_.get("results") or []:
                # The dependency file the package was declared in, relative
                # to the repository.
                for loc in res.get("locations") or []:
                    al = loc.setdefault("physicalLocation", {}).setdefault("artifactLocation", {})
                    uri = al.get("uri") or ""
                    al["uri"] = rel(src, uri) if os.path.isabs(uri) else (uri or rel(src, path))
                # GuardDog reports every rule as a warning. Its capability-*
                # rules describe what a package can do (read files, open
                # connections, start processes), which most legitimate
                # packages do; they are kept, as notes (low). The threat and
                # metadata rules (malware indicators, typosquatting) keep
                # GuardDog's level.
                if str(res.get("ruleId", "")).startswith("capability-"):
                    res["level"] = "note"
                if not res.get("locations"):
                    res["locations"] = [{"physicalLocation": {"artifactLocation": {"uri": rel(src, path)}}}]
            runs_out.append(run_)
    if base is None:
        write(out, b"")
        return finish(0, failures)
    base["runs"] = runs_out
    write(out, json.dumps(base).encode())
    return finish(len(targets) - len(failures), failures)


def depcheck(src, out, cache):
    """pathos-depcheck: dependency confusion and typosquatting (offline)."""
    return 0 if run([BIN + "/pathos-depcheck", "-o", out, src]) is not None else 3


def reach(src, out, cache):
    """pathos-reach: calls of dependency functions (and dynamic constructs) in
    the repository's JavaScript/TypeScript, Python and Java code, reflection
    in Go packages, for function-level reachability. Reads source files
    only; offline."""
    return 0 if run([BIN + "/pathos-reach", "-o", out, src]) is not None else 3


def cdxgen(src, out, cache):
    """cdxgen CycloneDX SBOM (with cryptographic assets) of the repository,
    from lockfiles and manifests only. It runs under the Node.js permission
    model: it can read the repository and write only its report and a
    temporary directory, and it cannot start processes (so no package
    manager or build tool of the repository runs)."""
    tmp = os.path.join(os.path.dirname(out), "cdxgen-tmp")
    os.makedirs(tmp, exist_ok=True)
    # CDXGEN_SECURE_MODE: cdxgen checks the permission model itself and
    # skips every command instead of failing on the first one.
    env = {"CDXGEN_SECURE_MODE": "true", "FETCH_LICENSE": "false", "CDXGEN_TEMP_DIR": tmp, "TMPDIR": tmp, "CDXGEN_NO_BANNER": "true",
           "NODE_NO_WARNINGS": "1", "CDX_MAVEN_SKIP": "true", "npm_config_update_notifier": "false"}
    args = [NODE, "--permission", "--allow-fs-read=" + SCA + "/npm/", "--allow-fs-read=" + src, "--allow-fs-read=" + tmp,
            "--allow-fs-write=" + tmp,
            SCA + "/npm/node_modules/@cyclonedx/cdxgen/bin/cdxgen.js", "-r", "--no-install-deps", "--include-crypto",
            # Secure mode fails on the first build tool it may not run; the
            # BOM is then made from the lockfiles and manifests.
            "--no-fail-on-error",
            "--spec-version", "1.6", "-o", os.path.join(tmp, "bom.json"), src]
    r = run(args, env=env)
    if r is not None:
        shutil.move(os.path.join(tmp, "bom.json"), out)
    shutil.rmtree(tmp, ignore_errors=True)
    return 0 if r is not None else 3


# --- versions ----------------------------------------------------------------


def version(tool):
    cmds = {
        "govulncheck": [BIN + "/govulncheck", "-version"],
        "pip-audit": [SCA + "/bin/pip-audit", "--version"],
        "cargo-audit": [BIN + "/cargo-audit", "--version"],
        "bundler-audit": ["/usr/local/bin/bundle-audit", "version"],
        "retire": [NODE, NPM_BIN + "/retire", "--version"],
        "npm-audit": [NODE, SCA + "/npm/node_modules/npm/bin/npm-cli.js", "--version"],
        "yarn-audit": [NODE, NPM_BIN + "/yarn", "--version"],
        "pnpm-audit": [NODE, NPM_BIN + "/pnpm", "--version"],
        "composer-audit": ["/usr/bin/php", SCA + "/composer.phar", "--version", "--no-plugins", "--no-interaction"],
        "dependency-check": [SCA + "/dependency-check/bin/dependency-check.sh", "--version"],
        "guarddog": [SCA + "/bin/guarddog", "--version"],
        "depcheck": [BIN + "/pathos-depcheck", "--version"],
        "cdxgen": [NODE, SCA + "/npm/node_modules/@cyclonedx/cdxgen/bin/cdxgen.js", "--version"],
        "reach": [BIN + "/pathos-reach", "--version"],
    }
    env = {"JAVA_HOME": SCA + "/jre", "COMPOSER_HOME": "/tmp/composer-version", "PIPAPI_PYTHON_LOCATION": BIN + "/pip-version",
           **GUARDDOG_ENV}
    env.update(node_env())
    r = subprocess.run(cmds[tool], capture_output=True, env={**os.environ, **env}, stdin=subprocess.DEVNULL)
    text = re.sub(r"\x1b\[[0-9;]*m", "", (r.stdout or r.stderr).decode(errors="replace"))
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    if tool == "govulncheck":
        lines = [l for l in lines if l.startswith("Scanner:")] or lines
    print(lines[0] if lines else "")
    return r.returncode


TOOLS = {
    "govulncheck": govulncheck, "pip-audit": pip_audit, "cargo-audit": cargo_audit, "bundler-audit": bundler_audit,
    "retire": retire, "npm-audit": npm_audit, "yarn-audit": yarn_audit, "pnpm-audit": pnpm_audit,
    "composer-audit": composer_audit, "dependency-check": dependency_check, "guarddog": guarddog, "depcheck": depcheck,
    "cdxgen": cdxgen, "reach": reach,
}


def main(argv):
    if len(argv) >= 2 and argv[0] in TOOLS and argv[1] == "--version":
        return version(argv[0])
    if len(argv) not in (3, 4) or argv[0] not in TOOLS:
        print(__doc__, file=sys.stderr)
        print("tools: " + ", ".join(sorted(TOOLS)), file=sys.stderr)
        return 2
    tool, src, out = argv[0], argv[1], argv[2]
    cache = argv[3] if len(argv) == 4 else os.path.join(os.path.dirname(out), "cache")
    os.makedirs(cache, mode=0o700, exist_ok=True)
    return TOOLS[tool](os.path.abspath(src), out, cache)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
