#!/usr/local/bin/python3 -I
"""Runs Kubescape offline on a directory: the frameworks bundled in the
image, no update check, results kept local. A repository without
Kubernetes manifests, Helm charts or Kustomize files is not an error (empty
report). Unparseable YAML or JSON files are skipped (VALIDATION_REPORT
O16): Kubescape skips them itself when the repository has Kubernetes
manifests, but when it has none it failed the whole run on, for example, a
duplicate mapping key in a CI file or a UTF-8 BOM in an appsettings.json.
That case is now an empty report with the skipped files named on standard
error. Any other Kubescape failure fails the run with Kubescape's message.

Usage: kubescape-scan <directory> <output file>
"""
import os
import subprocess
import sys

KUBESCAPE = "/opt/pathos/iac/bin/kubescape"
ENV = dict(os.environ, KS_SKIP_UPDATE_CHECK="true", KS_OFFLINE="true")
# Kubescape's messages for a directory without Kubernetes input (the
# wording changed between releases; 4.x prints the second one).
NO_INPUT = (b"no YAML or JSON manifest files found", b"no scannable Kubernetes resources found")
# Printed (and the run failed) when no Kubernetes resource loaded and some
# YAML/JSON files did not parse.
UNPARSEABLE_ONLY = b"failed to load one or more manifests"

if sys.argv[1:] == ["--version"]:
    os.execve(KUBESCAPE, [KUBESCAPE, "version"], ENV)
if len(sys.argv) != 3 or not os.path.isdir(sys.argv[1]):
    sys.stderr.write("usage: kubescape-scan <directory> <output file>\n")
    sys.exit(2)
src, out = sys.argv[1:]
run = subprocess.run([KUBESCAPE, "scan", src, "--format", "json", "--output", out, "--use-artifacts-from", "/opt/pathos/iac/kubescape",
                      "--keep-local", "--logger", "warning"], stderr=subprocess.PIPE, env=ENV, check=False)
sys.stderr.buffer.write(run.stderr)
if run.returncode != 0 and any(m in run.stderr for m in NO_INPUT):
    open(out, "wb").close()
    sys.exit(0)
if run.returncode != 0 and UNPARSEABLE_ONLY in run.stderr:
    import re
    bad = sorted(set(re.findall(rb'failed to parse "([^"]+)"', run.stderr)))
    names = ", ".join(os.path.relpath(b.decode(errors="replace"), src) for b in bad[:5])
    more = "" if len(bad) <= 5 else " and %d more" % (len(bad) - 5)
    sys.stderr.write("kubescape-scan: no Kubernetes resources; skipped %d unparseable YAML/JSON file(s): %s%s\n" % (len(bad), names, more))
    open(out, "wb").close()
    sys.exit(0)
sys.exit(run.returncode)
