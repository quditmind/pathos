# PATHOS configuration. Copy to .env, or run deploy/scripts/install.sh which
# generates every secret below. Never commit .env.

# --- Public endpoint ---------------------------------------------------------
# Base URL users open in the browser. Include the port if it is not 443.
PATHOS_PUBLIC_URL=https://localhost
PATHOS_DOMAIN=localhost
PATHOS_HTTPS_PORT=443
PATHOS_HTTP_PORT=80
# "internal" = Caddy local CA (browser warning until you trust it).
# Set to an email address to get a Let's Encrypt certificate for a public domain.
CADDY_TLS=internal

# --- Runtime -----------------------------------------------------------------
PATHOS_ENV=production
PATHOS_LOG_LEVEL=info
PATHOS_VERSION=dev
PATHOS_ORG_NAME="Default Organization"
PATHOS_ORG_SLUG=default
# "dev" starts Mailpit (SMTP sink, UI on http://127.0.0.1:8025). Empty in production.
COMPOSE_PROFILES=dev

# --- Bootstrap administrator (Keycloak user, forced password change) ---------
PATHOS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PATHOS_BOOTSTRAP_ADMIN_PASSWORD=change-me-generated

# --- Secrets (generate with: openssl rand -hex 32) --------------------------
# Master key for envelope encryption: 32 random bytes, base64 (openssl rand -base64 32).
# BACK IT UP: losing it makes every stored credential unrecoverable.
PATHOS_MASTER_KEY=
# Comma-separated older keys ("v1:<base64>") during rotation; see docs/SECURITY.md.
PATHOS_MASTER_KEYS_PREVIOUS=
POSTGRES_SUPERUSER_PASSWORD=
PATHOS_DB_OWNER_PASSWORD=
PATHOS_DB_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
VALKEY_PASSWORD=
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=
PATHOS_OIDC_CLIENT_SECRET=
PATHOS_KEYCLOAK_PROVISIONER_CLIENT_SECRET=
# Shared by the API and scan workers to register workers (each worker then
# receives its own revocable token).
PATHOS_WORKER_BOOTSTRAP_TOKEN=

# --- Scan workers ------------------------------------------------------------
# Workspace (tmpfs) and memory per worker. Scale with: docker compose up -d --scale worker-core=N
PATHOS_WORKER_TMPFS=3g
PATHOS_WORKER_MEMORY=4g

# --- SCM connectivity ----------------------------------------------------------
# Allow SCM base URLs on private networks (self-hosted GitHub Enterprise Server or
# Azure DevOps Server). Loopback and cloud metadata addresses are always blocked.
PATHOS_SCM_ALLOW_PRIVATE_NETWORKS=false
# Optional outbound proxy for SCM API calls, e.g. http://proxy.example.com:3128
PATHOS_HTTPS_PROXY=

# --- Email (used by Keycloak for invitations and password resets) -----------
PATHOS_SMTP_HOST=mailpit
PATHOS_SMTP_PORT=1025
PATHOS_SMTP_FROM=pathos@localhost
