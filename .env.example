# PATHOS configuration. Copy to .env, or run deploy/scripts/install.sh which
# generates every secret below. Never commit .env.

# --- Public endpoint ---------------------------------------------------------
# Base URL users open in the browser. Include the port if it is not 443.
PATHOS_PUBLIC_URL=https://localhost
PATHOS_DOMAIN=localhost
PATHOS_HTTPS_PORT=443
PATHOS_HTTP_PORT=80
# "internal" = Caddy local CA (browser warning until you trust it).
# Set to an email address to get a Let's Encrypt certificate for a public domain.
CADDY_TLS=internal

# --- Runtime -----------------------------------------------------------------
PATHOS_ENV=production
PATHOS_LOG_LEVEL=info
PATHOS_VERSION=dev
# Release images instead of local builds: set both, e.g.
#   PATHOS_IMAGE_PREFIX=ghcr.io/quditmind/   PATHOS_VERSION=0.9.0
# then: deploy/scripts/upgrade.sh --pull  (images are cosign-signed; see docs/OPERATIONS.md)
PATHOS_IMAGE_PREFIX=
PATHOS_ORG_NAME="Default Organization"
PATHOS_ORG_SLUG=default
# "dev" starts Mailpit (SMTP sink, UI on http://127.0.0.1:8025). Empty in production.
# Optional profiles: "ollama" (local LLM for AI review), "objectstore" (SeaweedFS),
# "observability" (Grafana LGTM). Comma-separated, e.g. COMPOSE_PROFILES=dev,ollama
COMPOSE_PROFILES=dev

# --- Bootstrap administrator (Keycloak user, forced password change) ---------
PATHOS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PATHOS_BOOTSTRAP_ADMIN_PASSWORD=change-me-generated

# --- Secrets (generate with: openssl rand -hex 32) --------------------------
# Master key for envelope encryption: 32 random bytes, base64 (openssl rand -base64 32).
# BACK IT UP: losing it makes every stored credential unrecoverable.
PATHOS_MASTER_KEY=
# Comma-separated older keys ("v1:<base64>") during rotation; see docs/SECURITY.md.
PATHOS_MASTER_KEYS_PREVIOUS=
POSTGRES_SUPERUSER_PASSWORD=
PATHOS_DB_OWNER_PASSWORD=
PATHOS_DB_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
VALKEY_PASSWORD=
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=
PATHOS_OIDC_CLIENT_SECRET=
PATHOS_KEYCLOAK_PROVISIONER_CLIENT_SECRET=
# Shared by the API and scan workers to register workers (each worker then
# receives its own revocable token).
PATHOS_WORKER_BOOTSTRAP_TOKEN=

# --- Scan workers ------------------------------------------------------------
# Workspace (tmpfs) and memory per worker. Scale with: docker compose up -d --scale worker-core=N
PATHOS_WORKER_TMPFS=3g
PATHOS_WORKER_MEMORY=4g

# --- SCM connectivity ----------------------------------------------------------
# Allow SCM base URLs on private networks (self-hosted GitHub Enterprise Server or
# Azure DevOps Server). Loopback and cloud metadata addresses are always blocked.
PATHOS_SCM_ALLOW_PRIVATE_NETWORKS=false
# Optional outbound proxy for SCM API calls, e.g. http://proxy.example.com:3128
PATHOS_HTTPS_PROXY=

# --- Email (Keycloak invitations; seeds PATHOS notification email once) ------
PATHOS_SMTP_HOST=mailpit
PATHOS_SMTP_PORT=1025
PATHOS_SMTP_FROM=pathos@localhost
# For a real relay: PATHOS_SMTP_STARTTLS=true, PATHOS_SMTP_AUTH=true and
# PATHOS_SMTP_USER / PATHOS_SMTP_PASSWORD.

# --- Production hardening (see docs/INSTALLATION.md) --------------------------
# 1 = the operations scripts use docker-compose.prod.yml (limits, log
# rotation, standby scheduler).
PATHOS_COMPOSE_PROD=0
# Who may open the Keycloak admin console: space-separated CIDRs, or
# "private_ranges". Required (no default) with the production override.
KEYCLOAK_ADMIN_ALLOW=private_ranges
# New users must enrol a TOTP authenticator at first login.
PATHOS_REQUIRE_MFA=false
# Multiplies all API rate limits; 0 disables rate limiting.
PATHOS_RATE_LIMIT_SCALE=1

# --- Object storage for scan artifacts (optional) -----------------------------
# Empty bucket keeps raw reports and SBOMs in PostgreSQL. To use the bundled
# SeaweedFS: add "objectstore" to COMPOSE_PROFILES and set
# PATHOS_S3_ENDPOINT=http://objectstore:8333 and PATHOS_S3_BUCKET=pathos-artifacts,
# then move existing artifacts with:
#   docker compose run --rm --entrypoint /usr/local/bin/pathosctl migrate migrate-artifacts
PATHOS_S3_ENDPOINT=
PATHOS_S3_BUCKET=
PATHOS_S3_REGION=us-east-1
PATHOS_S3_ACCESS_KEY=
PATHOS_S3_SECRET_KEY=

# --- Telemetry (optional) -----------------------------------------------------
# OTLP/HTTP endpoint for traces and metrics, e.g. http://otel-collector:4318.
# COMPOSE_PROFILES=observability starts a local Grafana LGTM at http://otel-lgtm:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Repository onboarding (docs/REPOSITORY_ONBOARDING.md) -------------------
# Uploads and source snapshots are encrypted with the master key and stored in
# the "sources" volume, or under PATHOS_SOURCE_S3_PREFIX in the S3 bucket when
# PATHOS_S3_BUCKET is set. Back them up together with PostgreSQL.
PATHOS_SOURCE_S3_PREFIX=sources/
# Largest accepted archive (bytes) and archive safety limits.
PATHOS_UPLOAD_MAX_BYTES=2147483648
PATHOS_IMPORT_MAX_FILES=200000
PATHOS_IMPORT_MAX_EXTRACTED_BYTES=8589934592
PATHOS_IMPORT_MAX_FILE_BYTES=1073741824
# Import workers in the jobs container and the per-repository time limit.
PATHOS_IMPORT_CONCURRENCY=2
PATHOS_IMPORT_TIMEOUT=30m
# Malware scanning of uploads: add "clamav" to COMPOSE_PROFILES and set the
# address. With PATHOS_CLAMAV_REQUIRED=true imports wait while clamd is down.
PATHOS_CLAMAV_ADDRESS=
PATHOS_CLAMAV_REQUIRED=false
# OAuth sign-in for GitHub, GitLab, Bitbucket and Azure DevOps (Microsoft Entra
# ID) uses OAuth applications registered in Admin > SCM connections; the
# redirect URI to register is ${PATHOS_PUBLIC_URL}/api/v1/scm-oauth/callback.
