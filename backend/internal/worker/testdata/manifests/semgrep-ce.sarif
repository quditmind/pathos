{"version":"2.1.0","runs":[{"invocations":[{"executionSuccessful":true,"toolExecutionNotifications":[]}],"results":[{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/go/main.go","uriBaseId":"%SRCROOT%"},"region":{"endColumn":72,"endLine":17,"snippet":{"text":"\t\trows, _ := db.Query(\"SELECT * FROM users WHERE name = '\" + name + \"'\")"},"startColumn":23,"startLine":17}}}],"message":{"text":"HTTP request data (query string, form, path or header values) is concatenated into an SQL statement that is passed to database/sql, sqlx or pgx. The value can change the statement (SQL injection). Use placeholders ($1 or ?) and pass the value as an argument."},"properties":{},"ruleId":"opt.pathos.rules.pathos.database.go.sql-string-concatenation"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/go/main.go","uriBaseId":"%SRCROOT%"},"region":{"endColumn":53,"endLine":20,"snippet":{"text":"\t\tfmt.Fprintf(w, \"%s %x\", out, md5.Sum([]byte(name)))"},"startColumn":32,"startLine":20}}}],"message":{"text":"MD5 or SHA-1 is used. Both have practical collision attacks and must not protect integrity, signatures or passwords; use crypto/sha256 or better (and argon2 or bcrypt for passwords)."},"properties":{},"ruleId":"opt.pathos.rules.pathos.crypto.go.weak-hash"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/go/main.go","uriBaseId":"%SRCROOT%"},"region":{"endColumn":106,"endLine":25,"snippet":{"text":"\tclient := &http.Client{Transport: &http.Transport{TLSClientConfig: &tls.Config{InsecureSkipVerify: true}}}"},"startColumn":70,"startLine":25}}}],"message":{"text":"InsecureSkipVerify disables TLS certificate verification."},"properties":{},"ruleId":"opt.pathos.rules.pathos.go.tls-insecure-skip-verify"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/py/service.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":36,"endLine":10,"snippet":{"text":"    subprocess.run(cmd, shell=True)"},"startColumn":5,"startLine":10}}}],"message":{"text":"subprocess with shell=True enables shell injection when arguments are not constant."},"properties":{},"ruleId":"opt.pathos.rules.pathos.python.subprocess-shell-true"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/py/service.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":21,"endLine":11,"snippet":{"text":"    return eval(cmd)"},"startColumn":12,"startLine":11}}}],"message":{"text":"eval() on a non-literal value can execute attacker-controlled code."},"properties":{},"ruleId":"opt.pathos.rules.pathos.python.eval-injection"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/py/service.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":47,"endLine":16,"snippet":{"text":"        return requests.get(url, verify=False).text"},"startColumn":16,"startLine":16}}}],"message":{"text":"TLS certificate verification is disabled."},"properties":{},"ruleId":"opt.pathos.rules.pathos.python.requests-verify-false"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/py/service.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":31,"endLine":23,"snippet":{"text":"    return pickle.load(handle)"},"startColumn":12,"startLine":23}}}],"message":{"text":"Unpickling data from an untrusted source executes arbitrary code."},"properties":{},"ruleId":"opt.pathos.rules.pathos.python.pickle-loads"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/py/service.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":29,"endLine":27,"snippet":{"text":"    return hashlib.md5(data).hexdigest()"},"startColumn":12,"startLine":27}}}],"message":{"text":"MD5 or SHA-1 is used. Both have practical collision attacks and must not protect integrity, signatures or passwords; use SHA-256 or better (and a password hash such as Argon2, scrypt or bcrypt for passwords). Pass usedforsecurity=False when the hash is not used for security."},"properties":{},"ruleId":"opt.pathos.rules.pathos.crypto.python.weak-hash"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/web/app.js","uriBaseId":"%SRCROOT%"},"region":{"endColumn":22,"endLine":6,"snippet":{"text":"const app = express();"},"startColumn":1,"startLine":6}}}],"message":{"text":"This Express application does not use helmet, so it sends none of the standard security headers (Content-Security-Policy, Strict-Transport-Security, X-Content-Type-Options, frame protection) and still advertises X-Powered-By. Add app.use(helmet()) before the routes."},"properties":{},"ruleId":"opt.pathos.rules.pathos.misconfig.express.helmet-missing"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/web/app.js","uriBaseId":"%SRCROOT%"},"region":{"endColumn":22,"endLine":6,"snippet":{"text":"const app = express();"},"startColumn":1,"startLine":6}}}],"message":{"text":"The Express application announces itself with the X-Powered-By header. Call app.disable(\"x-powered-by\") (helmet does this too) so the framework is not advertised to scanners."},"properties":{},"ruleId":"opt.pathos.rules.pathos.misconfig.express.x-powered-by"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/web/app.js","uriBaseId":"%SRCROOT%"},"region":{"endColumn":59,"endLine":9,"snippet":{"text":"  exec(\"ls \" + req.query.dir, (err, out) => res.send(out));"},"startColumn":3,"startLine":9}}}],"message":{"text":"child_process.exec runs a shell; non-constant commands enable command injection. Prefer execFile with an argument array."},"properties":{},"ruleId":"opt.pathos.rules.pathos.javascript.child-process-exec"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/web/app.js","uriBaseId":"%SRCROOT%"},"region":{"endColumn":39,"endLine":13,"snippet":{"text":"  res.send(String(eval(req.query.expr)));"},"startColumn":19,"startLine":13}}}],"message":{"text":"eval() / new Function() on a non-literal value can execute attacker-controlled code."},"properties":{},"ruleId":"opt.pathos.rules.pathos.javascript.eval"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/web/token.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":34,"endLine":17,"snippet":{"text":"  return crypto.createHash(\"md5\").update(data).digest(\"hex\");"},"startColumn":10,"startLine":17}}}],"message":{"text":"MD5 or SHA-1 is used. Both have practical collision attacks and must not protect integrity, signatures or passwords; use SHA-256 or better (and scrypt or Argon2 for passwords)."},"properties":{},"ruleId":"opt.pathos.rules.pathos.crypto.javascript.weak-hash"}],"tool":{"driver":{"name":"Semgrep OSS","rules":[{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"The system prompt (or instructions) of an LLM request is built from variables. If any of them carries user, document or tool content, that content gets the authority of the system prompt and can override the application's instructions (prompt injection). Keep the system prompt constant and pass untrusted content in a user message, clearly delimited."},"help":{"markdown":"The system prompt (or instructions) of an LLM request is built from variables. If any of them carries user, document or tool content, that content gets the authority of the system prompt and can override the application's instructions (prompt injection). Keep the system prompt constant and pass untrusted content in a user message, clearly delimited.\n\n<b>References:</b>\n - [https://genai.owasp.org/llmrisk/llm01-prompt-injection/](https://genai.owasp.org/llmrisk/llm01-prompt-injection/)\n","text":"The system prompt (or instructions) of an LLM request is built from variables. If any of them carries user, document or tool content, that content gets the authority of the system prompt and can override the application's instructions (prompt injection). Keep the system prompt constant and pass untrusted content in a user message, clearly delimited."},"id":"opt.pathos.rules.pathos.ai.javascript.dynamic-system-prompt","name":"opt.pathos.rules.pathos.ai.javascript.dynamic-system-prompt","properties":{"precision":"very-high","tags":["CWE-1427: Improper Neutralization of Input Used for LLM Prompting","CWE-77: Improper Neutralization of Special Elements used in a Command ('Command Injection')","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.ai.javascript.dynamic-system-prompt"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"An LLM provider API key is a constant in the source code. Anyone with the code (including a browser bundle) can use the account. Read the key from the environment on the server, and rotate this one."},"help":{"markdown":"An LLM provider API key is a constant in the source code. Anyone with the code (including a browser bundle) can use the account. Read the key from the environment on the server, and rotate this one.\n\n<b>References:</b>\n - [https://cwe.mitre.org/data/definitions/798.html](https://cwe.mitre.org/data/definitions/798.html)\n","text":"An LLM provider API key is a constant in the source code. Anyone with the code (including a browser bundle) can use the account. Read the key from the environment on the server, and rotate this one."},"id":"opt.pathos.rules.pathos.ai.javascript.hardcoded-llm-api-key","name":"opt.pathos.rules.pathos.ai.javascript.hardcoded-llm-api-key","properties":{"precision":"very-high","tags":["CWE-798: Use of Hard-coded Credentials","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.ai.javascript.hardcoded-llm-api-key"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Output of a language model (a completion, a tool or function call, generated text) reaches eval, new Function, the vm module, a shell command or an SQL query. Model output follows whatever instructions reached the model, including injected ones, so this executes attacker-controlled code, commands or SQL. Treat model output as untrusted: map it to allow-listed actions and use argument arrays and query parameters."},"help":{"markdown":"Output of a language model (a completion, a tool or function call, generated text) reaches eval, new Function, the vm module, a shell command or an SQL query. Model output follows whatever instructions reached the model, including injected ones, so this executes attacker-controlled code, commands or SQL. Treat model output as untrusted: map it to allow-listed actions and use argument arrays and query parameters.\n\n<b>References:</b>\n - [https://genai.owasp.org/llmrisk/llm052025-improper-output-handling/](https://genai.owasp.org/llmrisk/llm052025-improper-output-handling/)\n","text":"Output of a language model (a completion, a tool or function call, generated text) reaches eval, new Function, the vm module, a shell command or an SQL query. Model output follows whatever instructions reached the model, including injected ones, so this executes attacker-controlled code, commands or SQL. Treat model output as untrusted: map it to allow-listed actions and use argument arrays and query parameters."},"id":"opt.pathos.rules.pathos.ai.javascript.llm-output-execution","name":"opt.pathos.rules.pathos.ai.javascript.llm-output-execution","properties":{"precision":"very-high","tags":["CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","CWE-94: Improper Control of Generation of Code ('Code Injection')","HIGH CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.ai.javascript.llm-output-execution"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"The system prompt (or instructions) of an LLM request is built from variables. If any of them carries user, document or tool content, that content gets the authority of the system prompt and can override the application's instructions (prompt injection). Keep the system prompt constant and pass untrusted content in a user message, clearly delimited."},"help":{"markdown":"The system prompt (or instructions) of an LLM request is built from variables. If any of them carries user, document or tool content, that content gets the authority of the system prompt and can override the application's instructions (prompt injection). Keep the system prompt constant and pass untrusted content in a user message, clearly delimited.\n\n<b>References:</b>\n - [https://genai.owasp.org/llmrisk/llm01-prompt-injection/](https://genai.owasp.org/llmrisk/llm01-prompt-injection/)\n - [https://cwe.mitre.org/data/definitions/1427.html](https://cwe.mitre.org/data/definitions/1427.html)\n","text":"The system prompt (or instructions) of an LLM request is built from variables. If any of them carries user, document or tool content, that content gets the authority of the system prompt and can override the application's instructions (prompt injection). Keep the system prompt constant and pass untrusted content in a user message, clearly delimited."},"id":"opt.pathos.rules.pathos.ai.python.dynamic-system-prompt","name":"opt.pathos.rules.pathos.ai.python.dynamic-system-prompt","properties":{"precision":"very-high","tags":["CWE-1427: Improper Neutralization of Input Used for LLM Prompting","CWE-77: Improper Neutralization of Special Elements used in a Command ('Command Injection')","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.ai.python.dynamic-system-prompt"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"An LLM provider API key is a constant in the source code. Anyone with the code can use the account (and its spending limit). Read the key from the environment or a secrets manager, and rotate this one."},"help":{"markdown":"An LLM provider API key is a constant in the source code. Anyone with the code can use the account (and its spending limit). Read the key from the environment or a secrets manager, and rotate this one.\n\n<b>References:</b>\n - [https://cwe.mitre.org/data/definitions/798.html](https://cwe.mitre.org/data/definitions/798.html)\n","text":"An LLM provider API key is a constant in the source code. Anyone with the code can use the account (and its spending limit). Read the key from the environment or a secrets manager, and rotate this one."},"id":"opt.pathos.rules.pathos.ai.python.hardcoded-llm-api-key","name":"opt.pathos.rules.pathos.ai.python.hardcoded-llm-api-key","properties":{"precision":"very-high","tags":["CWE-798: Use of Hard-coded Credentials","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.ai.python.hardcoded-llm-api-key"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"An LLM provider API key is written into the process environment from a constant in the source code. Anyone with the code can use the account. Provide the variable from outside (deployment secrets) instead."},"help":{"markdown":"An LLM provider API key is written into the process environment from a constant in the source code. Anyone with the code can use the account. Provide the variable from outside (deployment secrets) instead.\n\n<b>References:</b>\n - [https://cwe.mitre.org/data/definitions/798.html](https://cwe.mitre.org/data/definitions/798.html)\n","text":"An LLM provider API key is written into the process environment from a constant in the source code. Anyone with the code can use the account. Provide the variable from outside (deployment secrets) instead."},"id":"opt.pathos.rules.pathos.ai.python.llm-api-key-in-environment","name":"opt.pathos.rules.pathos.ai.python.llm-api-key-in-environment","properties":{"precision":"very-high","tags":["CWE-798: Use of Hard-coded Credentials","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.ai.python.llm-api-key-in-environment"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"Output of a language model (a completion, a tool or function call, an agent result) reaches eval/exec, a shell command or an SQL statement. Model output follows whatever instructions reached the model, including injected ones, so this executes attacker-controlled code, commands or SQL. Treat model output as untrusted input: parse it into an allow-listed action, and use argument lists and query parameters."},"help":{"markdown":"Output of a language model (a completion, a tool or function call, an agent result) reaches eval/exec, a shell command or an SQL statement. Model output follows whatever instructions reached the model, including injected ones, so this executes attacker-controlled code, commands or SQL. Treat model output as untrusted input: parse it into an allow-listed action, and use argument lists and query parameters.\n\n<b>References:</b>\n - [https://genai.owasp.org/llmrisk/llm052025-improper-output-handling/](https://genai.owasp.org/llmrisk/llm052025-improper-output-handling/)\n","text":"Output of a language model (a completion, a tool or function call, an agent result) reaches eval/exec, a shell command or an SQL statement. Model output follows whatever instructions reached the model, including injected ones, so this executes attacker-controlled code, commands or SQL. Treat model output as untrusted input: parse it into an allow-listed action, and use argument lists and query parameters."},"id":"opt.pathos.rules.pathos.ai.python.llm-output-execution","name":"opt.pathos.rules.pathos.ai.python.llm-output-execution","properties":{"precision":"very-high","tags":["CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","CWE-94: Improper Control of Generation of Code ('Code Injection')","HIGH CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.ai.python.llm-output-execution"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"trust_remote_code=True downloads and runs Python code from the model repository when the model is loaded. Anyone who can change that repository (or the revision it resolves to) can run code here. Use models that need no custom code, or pin a reviewed commit with revision=\"<sha>\"."},"help":{"markdown":"trust_remote_code=True downloads and runs Python code from the model repository when the model is loaded. Anyone who can change that repository (or the revision it resolves to) can run code here. Use models that need no custom code, or pin a reviewed commit with revision=\"<sha>\".\n\n<b>References:</b>\n - [https://huggingface.co/docs/transformers/models#custom-models](https://huggingface.co/docs/transformers/models#custom-models)\n","text":"trust_remote_code=True downloads and runs Python code from the model repository when the model is loaded. Anyone who can change that repository (or the revision it resolves to) can run code here. Use models that need no custom code, or pin a reviewed commit with revision=\"<sha>\"."},"id":"opt.pathos.rules.pathos.ai.python.trust-remote-code","name":"opt.pathos.rules.pathos.ai.python.trust-remote-code","properties":{"precision":"very-high","tags":["CWE-829: Inclusion of Functionality from Untrusted Control Sphere","CWE-94: Improper Control of Generation of Code ('Code Injection')","HIGH CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.ai.python.trust-remote-code"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"A model or array file is loaded with a pickle-based loader (torch.load without weights_only=True, joblib, dill, cloudpickle, pandas.read_pickle, numpy.load with allow_pickle=True, Keras load_model with safe_mode=False). Loading a malicious model file runs arbitrary code. Use safetensors or ONNX, pass weights_only=True to torch.load, and load only files whose origin and hash you verified."},"help":{"markdown":"A model or array file is loaded with a pickle-based loader (torch.load without weights_only=True, joblib, dill, cloudpickle, pandas.read_pickle, numpy.load with allow_pickle=True, Keras load_model with safe_mode=False). Loading a malicious model file runs arbitrary code. Use safetensors or ONNX, pass weights_only=True to torch.load, and load only files whose origin and hash you verified.\n\n<b>References:</b>\n - [https://pytorch.org/docs/stable/generated/torch.load.html](https://pytorch.org/docs/stable/generated/torch.load.html)\n - [https://huggingface.co/docs/hub/security-pickle](https://huggingface.co/docs/hub/security-pickle)\n","text":"A model or array file is loaded with a pickle-based loader (torch.load without weights_only=True, joblib, dill, cloudpickle, pandas.read_pickle, numpy.load with allow_pickle=True, Keras load_model with safe_mode=False). Loading a malicious model file runs arbitrary code. Use safetensors or ONNX, pass weights_only=True to torch.load, and load only files whose origin and hash you verified."},"id":"opt.pathos.rules.pathos.ai.python.unsafe-model-load","name":"opt.pathos.rules.pathos.ai.python.unsafe-model-load","properties":{"precision":"very-high","tags":["CWE-502: Deserialization of Untrusted Data","HIGH CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.ai.python.unsafe-model-load"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"An Azure Pipelines step uses a macro of a value that the author of a commit, branch or pull request controls ($(Build.SourceVersionMessage), $(Build.SourceBranch), $(System.PullRequest.SourceBranch), ...). Macros are replaced in the script text before it runs, so quotes or shell metacharacters in the value become part of the script (script injection). Map the value to an environment variable (env:) and use \"$VAR\" in the script. A value mapped to a variable on its own (env: or a task input, NAME: $(Build.SourceBranch)) is not reported."},"help":{"markdown":"An Azure Pipelines step uses a macro of a value that the author of a commit, branch or pull request controls ($(Build.SourceVersionMessage), $(Build.SourceBranch), $(System.PullRequest.SourceBranch), ...). Macros are replaced in the script text before it runs, so quotes or shell metacharacters in the value become part of the script (script injection). Map the value to an environment variable (env:) and use \"$VAR\" in the script. A value mapped to a variable on its own (env: or a task input, NAME: $(Build.SourceBranch)) is not reported.\n\n<b>References:</b>\n - [https://learn.microsoft.com/en-us/azure/devops/pipelines/security/inputs](https://learn.microsoft.com/en-us/azure/devops/pipelines/security/inputs)\n - [https://learn.microsoft.com/en-us/azure/devops/pipelines/build/variables](https://learn.microsoft.com/en-us/azure/devops/pipelines/build/variables)\n","text":"An Azure Pipelines step uses a macro of a value that the author of a commit, branch or pull request controls ($(Build.SourceVersionMessage), $(Build.SourceBranch), $(System.PullRequest.SourceBranch), ...). Macros are replaced in the script text before it runs, so quotes or shell metacharacters in the value become part of the script (script injection). Map the value to an environment variable (env:) and use \"$VAR\" in the script. A value mapped to a variable on its own (env: or a task input, NAME: $(Build.SourceBranch)) is not reported."},"id":"opt.pathos.rules.pathos.cicd.azure.script-injection","name":"opt.pathos.rules.pathos.cicd.azure.script-injection","properties":{"precision":"very-high","tags":["CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","CWE-94: Improper Control of Generation of Code ('Code Injection')","HIGH CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.azure.script-injection"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"A repository resource (used for templates or extends) points to a branch (refs/heads/...). Whoever can push to that branch can change this pipeline's steps and read its secrets. Reference a tag (refs/tags/...) or a commit, and protect the template repository with required template checks."},"help":{"markdown":"A repository resource (used for templates or extends) points to a branch (refs/heads/...). Whoever can push to that branch can change this pipeline's steps and read its secrets. Reference a tag (refs/tags/...) or a commit, and protect the template repository with required template checks.\n\n<b>References:</b>\n - [https://learn.microsoft.com/en-us/azure/devops/pipelines/security/templates](https://learn.microsoft.com/en-us/azure/devops/pipelines/security/templates)\n - [https://learn.microsoft.com/en-us/azure/devops/pipelines/yaml-schema/resources-repositories-repository](https://learn.microsoft.com/en-us/azure/devops/pipelines/yaml-schema/resources-repositories-repository)\n","text":"A repository resource (used for templates or extends) points to a branch (refs/heads/...). Whoever can push to that branch can change this pipeline's steps and read its secrets. Reference a tag (refs/tags/...) or a commit, and protect the template repository with required template checks."},"id":"opt.pathos.rules.pathos.cicd.azure.unpinned-template-repository","name":"opt.pathos.rules.pathos.cicd.azure.unpinned-template-repository","properties":{"precision":"very-high","tags":["CWE-829: Inclusion of Functionality from Untrusted Control Sphere","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.azure.unpinned-template-repository"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"A Bitbucket Pipelines script uses a branch, tag or bookmark name ($BITBUCKET_BRANCH, $BITBUCKET_TAG) in eval, sh -c / bash -c, or unquoted. Whoever can push a branch chooses that name, so shell metacharacters or extra arguments in it are executed (command or argument injection). Quote the variable and never pass it to eval or a nested shell."},"help":{"markdown":"A Bitbucket Pipelines script uses a branch, tag or bookmark name ($BITBUCKET_BRANCH, $BITBUCKET_TAG) in eval, sh -c / bash -c, or unquoted. Whoever can push a branch chooses that name, so shell metacharacters or extra arguments in it are executed (command or argument injection). Quote the variable and never pass it to eval or a nested shell.\n\n<b>References:</b>\n - [https://support.atlassian.com/bitbucket-cloud/docs/variables-and-secrets/](https://support.atlassian.com/bitbucket-cloud/docs/variables-and-secrets/)\n","text":"A Bitbucket Pipelines script uses a branch, tag or bookmark name ($BITBUCKET_BRANCH, $BITBUCKET_TAG) in eval, sh -c / bash -c, or unquoted. Whoever can push a branch chooses that name, so shell metacharacters or extra arguments in it are executed (command or argument injection). Quote the variable and never pass it to eval or a nested shell."},"id":"opt.pathos.rules.pathos.cicd.bitbucket.script-injection","name":"opt.pathos.rules.pathos.cicd.bitbucket.script-injection","properties":{"precision":"very-high","tags":["CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","CWE-88: Improper Neutralization of Argument Delimiters in a Command ('Argument Injection')","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.bitbucket.script-injection"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"A Bitbucket pipe is used without a version or with :latest, so every run can get different (and possibly compromised) code with access to the step's secrets. Pin the pipe to an exact version (pipe: atlassian/name:1.2.3)."},"help":{"markdown":"A Bitbucket pipe is used without a version or with :latest, so every run can get different (and possibly compromised) code with access to the step's secrets. Pin the pipe to an exact version (pipe: atlassian/name:1.2.3).\n\n<b>References:</b>\n - [https://support.atlassian.com/bitbucket-cloud/docs/what-are-pipes/](https://support.atlassian.com/bitbucket-cloud/docs/what-are-pipes/)\n","text":"A Bitbucket pipe is used without a version or with :latest, so every run can get different (and possibly compromised) code with access to the step's secrets. Pin the pipe to an exact version (pipe: atlassian/name:1.2.3)."},"id":"opt.pathos.rules.pathos.cicd.bitbucket.unpinned-pipe","name":"opt.pathos.rules.pathos.cicd.bitbucket.unpinned-pipe","properties":{"precision":"very-high","tags":["CWE-829: Inclusion of Functionality from Untrusted Control Sphere","HIGH CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.bitbucket.unpinned-pipe"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"The pipeline downloads a script and runs it in a shell in one step (curl ... | sh). Whoever controls the server, the DNS or the network path at that moment controls the code that runs in the job, with its secrets. Download a pinned version, verify its checksum or signature, then run it."},"help":{"markdown":"The pipeline downloads a script and runs it in a shell in one step (curl ... | sh). Whoever controls the server, the DNS or the network path at that moment controls the code that runs in the job, with its secrets. Download a pinned version, verify its checksum or signature, then run it.\n\n<b>References:</b>\n - [https://docs.gitlab.com/ci/pipeline_security/](https://docs.gitlab.com/ci/pipeline_security/)\n - [https://slsa.dev/spec/v1.0/threats](https://slsa.dev/spec/v1.0/threats)\n","text":"The pipeline downloads a script and runs it in a shell in one step (curl ... | sh). Whoever controls the server, the DNS or the network path at that moment controls the code that runs in the job, with its secrets. Download a pinned version, verify its checksum or signature, then run it."},"id":"opt.pathos.rules.pathos.cicd.curl-pipe-shell","name":"opt.pathos.rules.pathos.cicd.curl-pipe-shell","properties":{"precision":"very-high","tags":["CWE-494: Download of Code Without Integrity Check","HIGH CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.curl-pipe-shell"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"A GitLab CI script uses a variable that the author of a commit, branch, tag or merge request controls (commit message, branch or tag name, merge request title or description) in eval, sh -c / bash -c, or unquoted. Shell metacharacters in that value then run as commands, or the value splits into extra arguments (argument injection). Quote the variable (\"$CI_COMMIT_BRANCH\") and never pass it to eval or a nested shell."},"help":{"markdown":"A GitLab CI script uses a variable that the author of a commit, branch, tag or merge request controls (commit message, branch or tag name, merge request title or description) in eval, sh -c / bash -c, or unquoted. Shell metacharacters in that value then run as commands, or the value splits into extra arguments (argument injection). Quote the variable (\"$CI_COMMIT_BRANCH\") and never pass it to eval or a nested shell.\n\n<b>References:</b>\n - [https://docs.gitlab.com/ci/variables/predefined_variables/](https://docs.gitlab.com/ci/variables/predefined_variables/)\n - [https://docs.gitlab.com/ci/pipeline_security/](https://docs.gitlab.com/ci/pipeline_security/)\n","text":"A GitLab CI script uses a variable that the author of a commit, branch, tag or merge request controls (commit message, branch or tag name, merge request title or description) in eval, sh -c / bash -c, or unquoted. Shell metacharacters in that value then run as commands, or the value splits into extra arguments (argument injection). Quote the variable (\"$CI_COMMIT_BRANCH\") and never pass it to eval or a nested shell."},"id":"opt.pathos.rules.pathos.cicd.gitlab.script-injection","name":"opt.pathos.rules.pathos.cicd.gitlab.script-injection","properties":{"precision":"very-high","tags":["CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","CWE-88: Improper Neutralization of Argument Delimiters in a Command ('Argument Injection')","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.gitlab.script-injection"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"The pipeline includes configuration that can change without a change to this repository: a remote URL without an integrity hash, a project file from a branch (or without ref, the default branch), or a CI/CD component at ~latest or a branch. Whoever can change that source can change the jobs and read their secrets. Pin includes to a tag or commit SHA, and add integrity: to remote includes."},"help":{"markdown":"The pipeline includes configuration that can change without a change to this repository: a remote URL without an integrity hash, a project file from a branch (or without ref, the default branch), or a CI/CD component at ~latest or a branch. Whoever can change that source can change the jobs and read their secrets. Pin includes to a tag or commit SHA, and add integrity: to remote includes.\n\n<b>References:</b>\n - [https://docs.gitlab.com/ci/yaml/includes/](https://docs.gitlab.com/ci/yaml/includes/)\n - [https://docs.gitlab.com/ci/yaml/#includeintegrity](https://docs.gitlab.com/ci/yaml/#includeintegrity)\n","text":"The pipeline includes configuration that can change without a change to this repository: a remote URL without an integrity hash, a project file from a branch (or without ref, the default branch), or a CI/CD component at ~latest or a branch. Whoever can change that source can change the jobs and read their secrets. Pin includes to a tag or commit SHA, and add integrity: to remote includes."},"id":"opt.pathos.rules.pathos.cicd.gitlab.unpinned-include","name":"opt.pathos.rules.pathos.cicd.gitlab.unpinned-include","properties":{"precision":"very-high","tags":["CWE-494: Download of Code Without Integrity Check","CWE-829: Inclusion of Functionality from Untrusted Control Sphere","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.gitlab.unpinned-include"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"The Jenkinsfile downloads a script and runs it in a shell in one step (curl ... | sh). Whoever controls the server, the DNS or the network path at that moment controls the code that runs on the agent, with its credentials. Download a pinned version, verify its checksum or signature, then run it."},"help":{"markdown":"The Jenkinsfile downloads a script and runs it in a shell in one step (curl ... | sh). Whoever controls the server, the DNS or the network path at that moment controls the code that runs on the agent, with its credentials. Download a pinned version, verify its checksum or signature, then run it.\n\n<b>References:</b>\n - [https://slsa.dev/spec/v1.0/threats](https://slsa.dev/spec/v1.0/threats)\n","text":"The Jenkinsfile downloads a script and runs it in a shell in one step (curl ... | sh). Whoever controls the server, the DNS or the network path at that moment controls the code that runs on the agent, with its credentials. Download a pinned version, verify its checksum or signature, then run it."},"id":"opt.pathos.rules.pathos.cicd.jenkins.curl-pipe-shell","name":"opt.pathos.rules.pathos.cicd.jenkins.curl-pipe-shell","properties":{"precision":"very-high","tags":["CWE-494: Download of Code Without Integrity Check","HIGH CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.jenkins.curl-pipe-shell"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"A Jenkins pipeline runs a privileged container or mounts the Docker socket into one. Code in the build can then take over the agent and every other build on it. Use rootless builders or isolated agents."},"help":{"markdown":"A Jenkins pipeline runs a privileged container or mounts the Docker socket into one. Code in the build can then take over the agent and every other build on it. Use rootless builders or isolated agents.\n\n<b>References:</b>\n - [https://docs.docker.com/engine/security/#docker-daemon-attack-surface](https://docs.docker.com/engine/security/#docker-daemon-attack-surface)\n","text":"A Jenkins pipeline runs a privileged container or mounts the Docker socket into one. Code in the build can then take over the agent and every other build on it. Use rootless builders or isolated agents."},"id":"opt.pathos.rules.pathos.cicd.jenkins.privileged-docker","name":"opt.pathos.rules.pathos.cicd.jenkins.privileged-docker","properties":{"precision":"very-high","tags":["CWE-250: Execution with Unnecessary Privileges","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.jenkins.privileged-docker"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"A Jenkinsfile interpolates a value that a branch, pull request or build parameter controls (BRANCH_NAME, CHANGE_TITLE, CHANGE_BRANCH, TAG_NAME, params.*) into a double-quoted sh/bat/powershell script. Groovy inserts it into the script text before the shell runs, so quotes or metacharacters in it run as commands (script injection). Use a single-quoted script and read the value from the environment ('echo \"$BRANCH_NAME\"')."},"help":{"markdown":"A Jenkinsfile interpolates a value that a branch, pull request or build parameter controls (BRANCH_NAME, CHANGE_TITLE, CHANGE_BRANCH, TAG_NAME, params.*) into a double-quoted sh/bat/powershell script. Groovy inserts it into the script text before the shell runs, so quotes or metacharacters in it run as commands (script injection). Use a single-quoted script and read the value from the environment ('echo \"$BRANCH_NAME\"').\n\n<b>References:</b>\n - [https://www.jenkins.io/doc/book/pipeline/jenkinsfile/#string-interpolation](https://www.jenkins.io/doc/book/pipeline/jenkinsfile/#string-interpolation)\n - [https://www.jenkins.io/doc/book/pipeline/jenkinsfile/#injection-via-interpolation](https://www.jenkins.io/doc/book/pipeline/jenkinsfile/#injection-via-interpolation)\n","text":"A Jenkinsfile interpolates a value that a branch, pull request or build parameter controls (BRANCH_NAME, CHANGE_TITLE, CHANGE_BRANCH, TAG_NAME, params.*) into a double-quoted sh/bat/powershell script. Groovy inserts it into the script text before the shell runs, so quotes or metacharacters in it run as commands (script injection). Use a single-quoted script and read the value from the environment ('echo \"$BRANCH_NAME\"')."},"id":"opt.pathos.rules.pathos.cicd.jenkins.script-injection","name":"opt.pathos.rules.pathos.cicd.jenkins.script-injection","properties":{"precision":"very-high","tags":["CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","HIGH CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.jenkins.script-injection"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"A Jenkinsfile interpolates a secret-like variable (token, password, key, credential) into a double-quoted echo or sh/bat step. Groovy inserts the value into the script text, where it appears in the process list and can reach the build log unmasked. Use single quotes so the shell reads the value from the environment ('curl -u \"$USER:$TOKEN\" ...'), and never echo secrets."},"help":{"markdown":"A Jenkinsfile interpolates a secret-like variable (token, password, key, credential) into a double-quoted echo or sh/bat step. Groovy inserts the value into the script text, where it appears in the process list and can reach the build log unmasked. Use single quotes so the shell reads the value from the environment ('curl -u \"$USER:$TOKEN\" ...'), and never echo secrets.\n\n<b>References:</b>\n - [https://www.jenkins.io/doc/book/pipeline/jenkinsfile/#string-interpolation](https://www.jenkins.io/doc/book/pipeline/jenkinsfile/#string-interpolation)\n","text":"A Jenkinsfile interpolates a secret-like variable (token, password, key, credential) into a double-quoted echo or sh/bat step. Groovy inserts the value into the script text, where it appears in the process list and can reach the build log unmasked. Use single quotes so the shell reads the value from the environment ('curl -u \"$USER:$TOKEN\" ...'), and never echo secrets."},"id":"opt.pathos.rules.pathos.cicd.jenkins.secret-interpolation","name":"opt.pathos.rules.pathos.cicd.jenkins.secret-interpolation","properties":{"precision":"very-high","tags":["CWE-214: Invocation of Process Using Visible Sensitive Information","CWE-532: Insertion of Sensitive Information into Log File","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.jenkins.secret-interpolation"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"A Jenkins pipeline uses a Docker image without a tag or with :latest, so every build can get different (and possibly compromised) code with access to the build's credentials. Pin the image to a digest or an exact version tag."},"help":{"markdown":"A Jenkins pipeline uses a Docker image without a tag or with :latest, so every build can get different (and possibly compromised) code with access to the build's credentials. Pin the image to a digest or an exact version tag.\n\n<b>References:</b>\n - [https://www.jenkins.io/doc/book/pipeline/docker/](https://www.jenkins.io/doc/book/pipeline/docker/)\n","text":"A Jenkins pipeline uses a Docker image without a tag or with :latest, so every build can get different (and possibly compromised) code with access to the build's credentials. Pin the image to a digest or an exact version tag."},"id":"opt.pathos.rules.pathos.cicd.jenkins.unpinned-container-image","name":"opt.pathos.rules.pathos.cicd.jenkins.unpinned-container-image","properties":{"precision":"very-high","tags":["CWE-829: Inclusion of Functionality from Untrusted Control Sphere","HIGH CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.jenkins.unpinned-container-image"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"A Jenkins shared library is loaded without a version or from a branch. Whoever can push to that branch runs code in this pipeline (often with Jenkins' own permissions for trusted libraries). Pin the library to a tag or commit (@Library('name@v1.2.3'))."},"help":{"markdown":"A Jenkins shared library is loaded without a version or from a branch. Whoever can push to that branch runs code in this pipeline (often with Jenkins' own permissions for trusted libraries). Pin the library to a tag or commit (@Library('name@v1.2.3')).\n\n<b>References:</b>\n - [https://www.jenkins.io/doc/book/pipeline/shared-libraries/#library-versions](https://www.jenkins.io/doc/book/pipeline/shared-libraries/#library-versions)\n","text":"A Jenkins shared library is loaded without a version or from a branch. Whoever can push to that branch runs code in this pipeline (often with Jenkins' own permissions for trusted libraries). Pin the library to a tag or commit (@Library('name@v1.2.3'))."},"id":"opt.pathos.rules.pathos.cicd.jenkins.unpinned-shared-library","name":"opt.pathos.rules.pathos.cicd.jenkins.unpinned-shared-library","properties":{"precision":"very-high","tags":["CWE-829: Inclusion of Functionality from Untrusted Control Sphere","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.jenkins.unpinned-shared-library"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"A job runs privileged containers, mounts the Docker socket, or runs Docker-in-Docker without TLS (DOCKER_TLS_CERTDIR: \"\"). Code in the job (including dependencies and test code) can then take over the runner host and every other job on it. Use rootless builders (BuildKit rootless, Kaniko, Buildah) or dedicated, isolated runners."},"help":{"markdown":"A job runs privileged containers, mounts the Docker socket, or runs Docker-in-Docker without TLS (DOCKER_TLS_CERTDIR: \"\"). Code in the job (including dependencies and test code) can then take over the runner host and every other job on it. Use rootless builders (BuildKit rootless, Kaniko, Buildah) or dedicated, isolated runners.\n\n<b>References:</b>\n - [https://docs.gitlab.com/ci/docker/using_docker_build/](https://docs.gitlab.com/ci/docker/using_docker_build/)\n - [https://docs.docker.com/engine/security/#docker-daemon-attack-surface](https://docs.docker.com/engine/security/#docker-daemon-attack-surface)\n","text":"A job runs privileged containers, mounts the Docker socket, or runs Docker-in-Docker without TLS (DOCKER_TLS_CERTDIR: \"\"). Code in the job (including dependencies and test code) can then take over the runner host and every other job on it. Use rootless builders (BuildKit rootless, Kaniko, Buildah) or dedicated, isolated runners."},"id":"opt.pathos.rules.pathos.cicd.privileged-docker","name":"opt.pathos.rules.pathos.cicd.privileged-docker","properties":{"precision":"very-high","tags":["CWE-250: Execution with Unnecessary Privileges","CWE-269: Improper Privilege Management","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.privileged-docker"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"A pipeline script writes a variable whose name says it is a secret (token, password, key, credential) to the job log, or prints the whole environment. Masking works only for registered secret values and not for encoded or partial forms, and job logs are readable by many users. Do not print secrets; pass them to tools through stdin or files."},"help":{"markdown":"A pipeline script writes a variable whose name says it is a secret (token, password, key, credential) to the job log, or prints the whole environment. Masking works only for registered secret values and not for encoded or partial forms, and job logs are readable by many users. Do not print secrets; pass them to tools through stdin or files.\n\n<b>References:</b>\n - [https://docs.gitlab.com/ci/variables/#mask-a-cicd-variable](https://docs.gitlab.com/ci/variables/#mask-a-cicd-variable)\n - [https://learn.microsoft.com/en-us/azure/devops/pipelines/process/set-secret-variables](https://learn.microsoft.com/en-us/azure/devops/pipelines/process/set-secret-variables)\n","text":"A pipeline script writes a variable whose name says it is a secret (token, password, key, credential) to the job log, or prints the whole environment. Masking works only for registered secret values and not for encoded or partial forms, and job logs are readable by many users. Do not print secrets; pass them to tools through stdin or files."},"id":"opt.pathos.rules.pathos.cicd.secret-echoed","name":"opt.pathos.rules.pathos.cicd.secret-echoed","properties":{"precision":"very-high","tags":["CWE-532: Insertion of Sensitive Information into Log File","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.secret-echoed"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"A pipeline job image has no tag or uses :latest, so every run can get different (and possibly compromised) code with access to the job's secrets. Pin the image to a digest (image: name:tag@sha256:...) or at least to an exact version tag."},"help":{"markdown":"A pipeline job image has no tag or uses :latest, so every run can get different (and possibly compromised) code with access to the job's secrets. Pin the image to a digest (image: name:tag@sha256:...) or at least to an exact version tag.\n\n<b>References:</b>\n - [https://docs.gitlab.com/ci/yaml/#image](https://docs.gitlab.com/ci/yaml/#image)\n - [https://support.atlassian.com/bitbucket-cloud/docs/use-docker-images-as-build-environments/](https://support.atlassian.com/bitbucket-cloud/docs/use-docker-images-as-build-environments/)\n - [https://learn.microsoft.com/en-us/azure/devops/pipelines/process/container-phases](https://learn.microsoft.com/en-us/azure/devops/pipelines/process/container-phases)\n","text":"A pipeline job image has no tag or uses :latest, so every run can get different (and possibly compromised) code with access to the job's secrets. Pin the image to a digest (image: name:tag@sha256:...) or at least to an exact version tag."},"id":"opt.pathos.rules.pathos.cicd.unpinned-container-image","name":"opt.pathos.rules.pathos.cicd.unpinned-container-image","properties":{"precision":"very-high","tags":["CWE-1357: Reliance on Insufficiently Trustworthy Component","CWE-829: Inclusion of Functionality from Untrusted Control Sphere","HIGH CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.cicd.unpinned-container-image"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"ECB mode encrypts identical plaintext blocks to identical ciphertext blocks, so patterns in the data stay visible. Use AesGcm with a random nonce."},"help":{"markdown":"ECB mode encrypts identical plaintext blocks to identical ciphertext blocks, so patterns in the data stay visible. Use AesGcm with a random nonce.\n\n<b>References:</b>\n - [https://learn.microsoft.com/en-us/dotnet/api/system.security.cryptography.ciphermode](https://learn.microsoft.com/en-us/dotnet/api/system.security.cryptography.ciphermode)\n","text":"ECB mode encrypts identical plaintext blocks to identical ciphertext blocks, so patterns in the data stay visible. Use AesGcm with a random nonce."},"id":"opt.pathos.rules.pathos.crypto.csharp.ecb-mode","name":"opt.pathos.rules.pathos.crypto.csharp.ecb-mode","properties":{"precision":"very-high","tags":["CWE-327: Use of a Broken or Risky Cryptographic Algorithm","HIGH CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.crypto.csharp.ecb-mode"}},{"defaultConfiguration":{"level":"error"},"fullDescription":{"text":"An encryption, MAC or token-signing key is a constant in the source code. Anyone with the code can decrypt data or forge signatures and tokens. Load keys from a key vault or the configuration's secret store."},"help":{"markdown":"An encryption, MAC or token-signing key is a constant in the source code. Anyone with the code can decrypt data or forge signatures and tokens. Load keys from a key vault or the configuration's secret store.\n\n<b>References:</b>\n - [https://cwe.mitre.org/data/definitions/321.html](https://cwe.mitre.org/data/definitions/321.html)\n","text":"An encryption, MAC or token-signing key is a constant in the source code. Anyone with the code can decrypt data or forge signatures and tokens. Load keys from a key vault or the configuration's secret store."},"id":"opt.pathos.rules.pathos.crypto.csharp.hardcoded-key","name":"opt.pathos.rules.pathos.crypto.csharp.hardcoded-key","properties":{"precision":"very-high","tags":["CWE-321: Use of Hard-coded Cryptographic Key","MEDIUM CONFIDENCE","security"]},"shortDescription":{"text":"Semgrep Finding: opt.pathos.rules.pathos.crypto.csharp.hardcoded-key"}},{"defaultC