{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Pysa",
          "informationUri": "https://github.com/facebook/pyre-check/",
          "rules": [
            {
              "id": "5001",
              "name": "Possible shell injection"
            },
            {
              "id": "5005",
              "name": "User controlled data to SQL execution"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "5001",
          "level": "warning",
          "message": {
            "text": "Possible shell injection [5001]: Data from [UserControlled] source(s) may reach [RemoteCodeExecution] sink(s)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/views.py"
                },
                "region": {
                  "startLine": 6,
                  "startColumn": 27,
                  "endColumn": 31
                }
              }
            }
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "app/views.py",
                            "uriBaseId": "%SRCROOT%"
                          },
                          "region": {
                            "startLine": 15,
                            "startColumn": 4,
                            "endColumn": 30
                          }
                        },
                        "message": {
                          "text": "flow from app.views.view(...formal(request)...) -[into]-> app.views.run(...formal(cmd)...)"
                        }
                      },
                      "nestingLevel": 0
                    },
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "app/views.py",
                            "uriBaseId": "%SRCROOT%"
                          },
                          "region": {
                            "startLine": 6,
                            "startColumn": 4,
                            "endColumn": 30
                          }
                        },
                        "message": {
                          "text": "flow from app.views.run(...formal(cmd)...) -[into]-> subprocess.call(...formal(args)...)"
                        }
                      },
                      "nestingLevel": 1
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "ruleId": "5005",
          "level": "warning",
          "message": {
            "text": "User controlled data to SQL execution [5005]: Data from [UserControlled] source(s) may reach [SQL] sink(s)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/views.py"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 12,
                  "endColumn": 70
                }
              }
            }
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "app/views.py",
                            "uriBaseId": "%SRCROOT%"
                          },
                          "region": {
                            "startLine": 10,
                            "startColumn": 4,
                            "endColumn": 30
                          }
                        },
                        "message": {
                          "text": "flow from app.views.find(...formal(user)...) -[into]-> sqlite3.Cursor.execute(...formal(sql)...)"
                        }
                      },
                      "nestingLevel": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}