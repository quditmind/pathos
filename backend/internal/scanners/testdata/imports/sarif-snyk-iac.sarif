{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Snyk IaC",
          "fullName": "Snyk Infrastructure as Code",
          "version": "1.1294.0",
          "informationUri": "https://docs.snyk.io/products/snyk-infrastructure-as-code",
          "rules": [
            {
              "id": "SNYK-CC-K8S-1",
              "name": "Container is running in privileged mode",
              "shortDescription": {
                "text": "Medium severity - Container is running in privileged mode"
              },
              "fullDescription": {
                "text": "Kubernetes: Container is running in privileged mode"
              },
              "help": {
                "text": "Set `spec.{containers, initContainers}.securityContext.privileged` to `false`",
                "markdown": "Set `privileged` to `false`"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes"
                ],
                "problem": {
                  "severity": "medium"
                }
              },
              "helpUri": "https://security.snyk.io/rules/cloud/SNYK-CC-K8S-1"
            },
            {
              "id": "SNYK-CC-TF-4",
              "name": "S3 bucket is publicly readable",
              "shortDescription": {
                "text": "High severity - S3 bucket is publicly readable"
              },
              "fullDescription": {
                "text": "Terraform: S3 bucket is publicly readable"
              },
              "help": {
                "text": "Set `acl` to `private`"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "terraform"
                ],
                "problem": {
                  "severity": "high"
                }
              },
              "helpUri": "https://security.snyk.io/rules/cloud/SNYK-CC-TF-4"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SNYK-CC-K8S-1",
          "level": "warning",
          "message": {
            "text": "This line contains a potential medium severity misconfiguration affecting the Kubernetes Deployment"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "k8s/deployment.yaml"
                },
                "region": {
                  "startLine": 21
                }
              }
            }
          ],
          "ruleIndex": 0
        },
        {
          "ruleId": "SNYK-CC-TF-4",
          "level": "error",
          "message": {
            "text": "This line contains a potential high severity misconfiguration affecting the AWS S3 Bucket"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tf/main.tf"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "ruleIndex": 1
        }
      ]
    }
  ]
}