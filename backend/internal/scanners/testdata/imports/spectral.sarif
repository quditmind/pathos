{
  "$schema": "http://json.schemastore.org/sarif-2.1.0-rtm.6.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "spectral",
          "rules": [
            {
              "id": "info-contact",
              "shortDescription": {
                "text": "Info object must have \"contact\" object."
              },
              "helpUri": "https://meta.stoplight.io/docs/spectral/docs/reference/openapi-rules.md#info-contact"
            },
            {
              "id": "info-description",
              "shortDescription": {
                "text": "Info \"description\" must be present and non-empty string."
              },
              "helpUri": "https://meta.stoplight.io/docs/spectral/docs/reference/openapi-rules.md#info-description"
            },
            {
              "id": "operation-description",
              "shortDescription": {
                "text": "Operation \"description\" must be present and non-empty string."
              },
              "helpUri": "https://meta.stoplight.io/docs/spectral/docs/reference/openapi-rules.md#operation-description"
            }
          ],
          "version": "6.14.3",
          "informationUri": "https://github.com/stoplightio/spectral"
        }
      },
      "results": [
        {
          "level": "warning",
          "message": {
            "text": "Info object must have \"contact\" object."
          },
          "ruleId": "info-contact",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "../src/api/openapi.yaml",
                  "index": 0
                },
                "region": {
                  "startLine": 2,
                  "startColumn": 6,
                  "endLine": 4,
                  "endColumn": 17
                }
              }
            }
          ],
          "ruleIndex": 0
        },
        {
          "level": "warning",
          "message": {
            "text": "Info \"description\" must be present and non-empty string."
          },
          "ruleId": "info-description",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "../src/api/openapi.yaml",
                  "index": 0
                },
                "region": {
                  "startLine": 2,
                  "startColumn": 6,
                  "endLine": 4,
                  "endColumn": 17
                }
              }
            }
          ],
          "ruleIndex": 1
        },
        {
          "level": "warning",
          "message": {
            "text": "Operation \"description\" must be present and non-empty string."
          },
          "ruleId": "operation-description",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "../src/api/openapi.yaml",
                  "index": 0
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 9,
                  "endLine": 18,
                  "endColumn": 26
                }
              }
            }
          ],
          "ruleIndex": 2
        }
      ]
    }
  ]
}