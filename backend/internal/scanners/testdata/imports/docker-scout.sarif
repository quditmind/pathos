{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "docker scout",
          "fullName": "Docker Scout",
          "informationUri": "https://docker.com/products/docker-scout",
          "rules": [
            {
              "id": "CVE-2024-5535",
              "name": "OsPackageVulnerability",
              "shortDescription": {"text": "CVE-2024-5535"},
              "helpUri": "https://scout.docker.com/v/CVE-2024-5535",
              "help": {
                "text": "Issue in SSL_select_next_proto with an empty supported client protocols buffer.",
                "markdown": "| | |\n|--|--|\n| Package | pkg:apk/alpine/openssl@3.1.4-r5?os_name=alpine&os_version=3.19 |\n| Affected range | <3.1.6-r0 |\n| Fixed version | 3.1.6-r0 |"
              },
              "properties": {
                "affected_version": "<3.1.6-r0",
                "cvssV3_severity": "CRITICAL",
                "fixed_version": "3.1.6-r0",
                "purls": ["pkg:apk/alpine/openssl@3.1.4-r5?os_name=alpine&os_version=3.19"],
                "security-severity": "9.1",
                "tags": ["CRITICAL"]
              }
            },
            {
              "id": "CVE-2023-42363",
              "name": "OsPackageVulnerability",
              "shortDescription": {"text": "CVE-2023-42363"},
              "helpUri": "https://scout.docker.com/v/CVE-2023-42363",
              "help": {"text": "A use-after-free vulnerability in BusyBox awk."},
              "properties": {
                "affected_version": "<1.36.1-r16",
                "cvssV3_severity": "MEDIUM",
                "fixed_version": "1.36.1-r16",
                "purls": ["pkg:apk/alpine/busybox@1.36.1-r15?os_name=alpine&os_version=3.19"],
                "security-severity": "5.5",
                "tags": ["MEDIUM"]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2024-5535",
          "ruleIndex": 0,
          "kind": "fail",
          "level": "error",
          "message": {"text": "  Vulnerability   : CVE-2024-5535\n  Severity        : CRITICAL\n  Package         : pkg:apk/alpine/openssl@3.1.4-r5?os_name=alpine&os_version=3.19\n  Affected range  : <3.1.6-r0\n  Fixed version   : 3.1.6-r0\n"},
          "locations": [
            {"physicalLocation": {"artifactLocation": {"uri": "/lib/apk/db/installed"}}}
          ]
        },
        {
          "ruleId": "CVE-2023-42363",
          "ruleIndex": 1,
          "kind": "fail",
          "level": "warning",
          "message": {"text": "  Vulnerability   : CVE-2023-42363\n  Severity        : MEDIUM\n  Package         : pkg:apk/alpine/busybox@1.36.1-r15?os_name=alpine&os_version=3.19\n  Affected range  : <1.36.1-r16\n  Fixed version   : 1.36.1-r16\n"},
          "locations": [
            {"physicalLocation": {"artifactLocation": {"uri": "/lib/apk/db/installed"}}}
          ]
        }
      ]
    }
  ]
}
