{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "PVS-Studio",
          "semanticVersion": "7.33",
          "informationUri": "https://pvs-studio.com",
          "rules": [
            {
              "id": "V522",
              "name": "Dereferencing of the null pointer might take place",
              "helpUri": "https://pvs-studio.com/en/docs/warnings/v522/"
            },
            {
              "id": "V774",
              "name": "The pointer was used after the memory was released",
              "helpUri": "https://pvs-studio.com/en/docs/warnings/v774/"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "V522",
          "level": "error",
          "message": {
            "text": "V522 Dereferencing of the null pointer 'q' might take place."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main.c"
                },
                "region": {
                  "startLine": 8
                }
              }
            }
          ]
        },
        {
          "ruleId": "V774",
          "level": "error",
          "message": {
            "text": "V774 The 'p' pointer was used after the memory was released."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main.c"
                },
                "region": {
                  "startLine": 6
                }
              }
            }
          ]
        }
      ]
    }
  ]
}