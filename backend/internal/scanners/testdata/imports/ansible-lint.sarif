{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.5.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ansible-lint",
          "version": "25.11.0",
          "informationUri": "https://github.com/ansible/ansible-lint",
          "rules": [
            {
              "id": "name[play]",
              "name": "name[play]",
              "shortDescription": {
                "text": "All plays should be named."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "All tasks and plays should have a distinct name for readability and for ``--start-at-task`` to work"
              },
              "helpUri": "https://ansible.readthedocs.io/projects/lint/rules/name/",
              "properties": {
                "tags": [
                  "idiom"
                ]
              }
            },
            {
              "id": "command-instead-of-module",
              "name": "command-instead-of-module",
              "shortDescription": {
                "text": "curl used in place of get_url or uri module"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "Executing a command when there is an Ansible module is generally a bad idea"
              },
              "helpUri": "https://ansible.readthedocs.io/projects/lint/rules/command-instead-of-module/",
              "properties": {
                "tags": [
                  "command-shell",
                  "idiom"
                ]
              }
            },
            {
              "id": "fqcn[action-core]",
              "name": "fqcn[action-core]",
              "shortDescription": {
                "text": "Use FQCN for builtin module actions (shell)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "Check whether actions are using using full qualified collection names."
              },
              "helpUri": "https://ansible.readthedocs.io/projects/lint/rules/fqcn/",
              "properties": {
                "tags": [
                  "formatting"
                ]
              }
            }
          ]
        }
      },
      "columnKind": "utf16CodeUnits",
      "results": [
        {
          "ruleId": "name[play]",
          "level": "error",
          "message": {
            "text": "All plays should be named."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ansible/site.yml",
                  "uriBaseId": "SRCROOT"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "command-instead-of-module",
          "level": "error",
          "message": {
            "text": "Task/Handler: shell curl http://example.test/install.sh | sh"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ansible/site.yml",
                  "uriBaseId": "SRCROOT"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "fqcn[action-core]",
          "level": "error",
          "message": {
            "text": "Use `ansible.builtin.shell` or `ansible.legacy.shell` instead."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ansible/site.yml",
                  "uriBaseId": "SRCROOT"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 7
                }
              }
            }
          ]
        }
      ],
      "originalUriBaseIds": {
        "SRCROOT": {
          "uri": "file:///tmp/w/"
        }
      }
    }
  ]
}