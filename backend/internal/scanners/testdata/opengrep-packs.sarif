d parameters: text(\"... WHERE id = :id\") with execute(stmt, {\"id\": value})."},"properties":{},"ruleId":"opt.pathos.rules.pathos.database.python.sqlalchemy-text-formatting"},{"fingerprints":{"matchBasedId/v1":"71c72e227e01bdd2b760d8b3219aea2cd430d5c0c9dcd68ad90d3a200bb2925c789e38a527344128eca4daa43fa4fc8cb125494803b2d32facba5a27316cc6f2_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/db.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":71,"endLine":44,"snippet":{"text":"    r2 = session.execute(text(\"SELECT * FROM users WHERE id = \" + uid))"},"startColumn":26,"startLine":44}}}],"message":{"text":"sqlalchemy.text() receives a statement built with string formatting or concatenation, so values become SQL (SQL injection). Use bound parameters: text(\"... WHERE id = :id\") with execute(stmt, {\"id\": value})."},"properties":{},"ruleId":"opt.pathos.rules.pathos.database.python.sqlalchemy-text-formatting"},{"fingerprints":{"matchBasedId/v1":"64580bf22bb27db8cb69d1eac827f72b5f34c063101dc130a31865893949a568802f62ddac8b3eb7d3b6d95c0772f905bfed2019ba26dcb33f475912989ef59c_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/db.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":82,"endLine":53,"snippet":{"text":"    user = db.users.find_one({\"name\": body[\"name\"], \"password\": body[\"password\"]})"},"startColumn":30,"startLine":53}}}],"message":{"text":"Request data reaches a MongoDB query without validation. A JSON body can carry query operators ($ne, $gt, $regex, $where) instead of plain values and change what the query matches, for example to bypass a log-in check (NoSQL injection). Convert values to the expected type (str(), int()) or validate them with a schema."},"properties":{},"ruleId":"opt.pathos.rules.pathos.database.python.nosql-injection"},{"fingerprints":{"matchBasedId/v1":"c07bb5858ef72a049d02e059354ab23d5533fdad1faec6e965d17e7130f39b107c2bc222ea700f5af70019e06edfca81e08fe74474fbd88b4e9ec48346856c76_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/db.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":79,"endLine":62,"snippet":{"text":"DATABASE_URL = \"postgresql://app:fixture-db-pass-not-real@db.internal:5432/app\""},"startColumn":17,"startLine":62}}}],"message":{"text":"A database connection string contains a plaintext password. Anyone who can read the code or configuration can log in to the database, and the password cannot be rotated without a change. Read the credentials from a secrets manager or the environment and keep only placeholders in the repository."},"properties":{},"ruleId":"opt.pathos.rules.pathos.database.connection-string-hardcoded-password"},{"fingerprints":{"matchBasedId/v1":"6a75db6f2a1b0ace7b718523f506035207a97ae275f8181ecd991383666e7e774702688eb7e27172e8dd43427b1409de61def1f3b12f8b19542ca6b01716065d_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/db.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":68,"endLine":68,"snippet":{"text":"REPLICA_URL = \"postgresql://db-replica.internal/app?sslmode=disable\""},"startColumn":52,"startLine":68}}}],"message":{"text":"A database connection string turns TLS off or accepts any server certificate (sslmode=disable, useSSL=false, Encrypt=False, TrustServerCertificate=True, tlsInsecure=true and similar). Credentials and data then cross the network unprotected, or a network attacker can impersonate the database. Require TLS and verify the certificate (sslmode=verify-full, Encrypt=True)."},"properties":{},"ruleId":"opt.pathos.rules.pathos.database.connection-string-tls-disabled"},{"fingerprints":{"matchBasedId/v1":"fcd294aa5bef6d89ba3b75d53edc30cb99e8b0537968d5d00909256581a99ba4606532c0be87e27643c7e67365268640c46ce997da3f7adfedc633a309b02a67_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/llm_app.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":82,"endLine":23,"snippet":{"text":"    bad = [{\"role\": \"system\", \"content\": f\"You help {user.name}. Context: {doc}\"}]"},"startColumn":12,"startLine":23}}}],"message":{"text":"The system prompt (or instructions) of an LLM request is built from variables. If any of them carries user, document or tool content, that content gets the authority of the system prompt and can override the application's instructions (prompt injection). Keep the system prompt constant and pass untrusted content in a user message, clearly delimited."},"properties":{},"ruleId":"opt.pathos.rules.pathos.ai.python.dynamic-system-prompt"},{"fingerprints":{"matchBasedId/v1":"0a792088865fb5dbeeff9182f1b3cafed2d2fbf50e4abe34eed4fac99fc026d7c3c58fb7510951d51958a24989360c916339ac3ea7d35b9dbb3b1551330288a3_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/llm_app.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":62,"endLine":25,"snippet":{"text":"    msg = SystemMessage(content=\"Follow these rules: \" + doc)"},"startColumn":11,"startLine":25}}}],"message":{"text":"The system prompt (or instructions) of an LLM request is built from variables. If any of them carries user, document or tool content, that content gets the authority of the system prompt and can override the application's instructions (prompt injection). Keep the system prompt constant and pass untrusted content in a user message, clearly delimited."},"properties":{},"ruleId":"opt.pathos.rules.pathos.ai.python.dynamic-system-prompt"},{"fingerprints":{"matchBasedId/v1":"34427ac9fd9c988586a035f40e9663a34ccbcf04b9a7877ec7d4b6c2508d2c8bb03211d3f6136df88c3dcd32da81c5c2fe155cf7d7646c7a955d0b8b2b145b87_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/llm_app.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":108,"endLine":27,"snippet":{"text":"    r = client.messages.create(model=\"m\", max_tokens=100, system=f\"Summarise for {user.role}\", messages=ok)"},"startColumn":9,"startLine":27}}}],"message":{"text":"The system prompt (or instructions) of an LLM request is built from variables. If any of them carries user, document or tool content, that content gets the authority of the system prompt and can override the application's instructions (prompt injection). Keep the system prompt constant and pass untrusted content in a user message, clearly delimited."},"properties":{},"ruleId":"opt.pathos.rules.pathos.ai.python.dynamic-system-prompt"},{"fingerprints":{"matchBasedId/v1":"833e641fd350e48b5577a9da7598a126b4c7ccef5bf6cd0e0cc10adb8ab68538037ce7fc2bf71328e5e9ec5fd2bfe219d91e805052c0114c6ccd8b397aa265b0_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/llm_app.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":15,"endLine":37,"snippet":{"text":"    exec(code)"},"startColumn":5,"startLine":37}}}],"message":{"text":"Output of a language model (a completion, a tool or function call, an agent result) reaches eval/exec, a shell command or an SQL statement. Model output follows whatever instructions reached the model, including injected ones, so this executes attacker-controlled code, commands or SQL. Treat model output as untrusted input: parse it into an allow-listed action, and use argument lists and query parameters."},"properties":{},"ruleId":"opt.pathos.rules.pathos.ai.python.llm-output-execution"},{"fingerprints":{"matchBasedId/v1":"3abf74e32dac481774dad7ff01890eb04d81b42b581907f27e6177365c96c1b0b2716b3ac75e220b67df8eeb96c9d8a3e722a02a947633d9231e4f762707a3a0_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/llm_app.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":48,"endLine":41,"snippet":{"text":"    subprocess.run(args[\"command\"], shell=True)"},"startColumn":5,"startLine":41}}}],"message":{"text":"Output of a language model (a completion, a tool or function call, an agent result) reaches eval/exec, a shell command or an SQL statement. Model output follows whatever instructions reached the model, including injected o