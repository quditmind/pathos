he data stay visible and blocks can be reordered. Use an authenticated mode (AES-GCM) with a random nonce."},"properties":{},"ruleId":"opt.pathos.rules.pathos.crypto.python.ecb-mode"},{"fingerprints":{"matchBasedId/v1":"9c9f5dbb2e7e6eb6e5d0b669488f98432cb22ea6c3e5823639d59f57c9e79730c6300ac1efbb87a7b0703c2ba7f8f7f01ba4d5d413cc74c6117fee98ee92643c_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/crypto.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":58,"endLine":49,"snippet":{"text":"    cbc = AES.new(key, AES.MODE_CBC, b\"0000000000000000\")"},"startColumn":11,"startLine":49}}}],"message":{"text":"The IV or nonce is a constant. Reusing an IV with the same key reveals relations between messages (CBC, CFB) and breaks confidentiality and integrity completely for CTR and GCM. Generate a new random IV for every message (os.urandom or secrets.token_bytes) and store it with the ciphertext."},"properties":{},"ruleId":"opt.pathos.rules.pathos.crypto.python.static-iv"},{"fingerprints":{"matchBasedId/v1":"cc098bac066e8c60119da83598031ede5a3e06af58dc2a881bceb6a4ef7be805381e6e4b1e7833486774fd248dfc9788dfdf082adfde36f36f5282b7e3822d9c_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/crypto.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":62,"endLine":51,"snippet":{"text":"    ctr = Cipher(algorithms.AES(key), modes.CTR(b\"\\x00\" * 16))"},"startColumn":39,"startLine":51}}}],"message":{"text":"The IV or nonce is a constant. Reusing an IV with the same key reveals relations between messages (CBC, CFB) and breaks confidentiality and integrity completely for CTR and GCM. Generate a new random IV for every message (os.urandom or secrets.token_bytes) and store it with the ciphertext."},"properties":{},"ruleId":"opt.pathos.rules.pathos.crypto.python.static-iv"},{"fingerprints":{"matchBasedId/v1":"628e1db48436cbbb4851a7660831720014e513e6b82df43f127de8f19833f850daa98a557b50405a20241abe152e99b575bbef706f0c392a8bb43d5e