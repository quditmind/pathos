{"version":"2.1.0","runs":[{"invocations":[{"executionSuccessful":true,"toolExecutionNotifications":[]}],"results":[{"fingerprints":{"matchBasedId/v1":"dcf1c31ed9b79400c2a156bb8e3953c85fcb341eff6a44d505c574607b7478e6b618b2e4b57d0cd8a13af68cc0c1c2a04eeae318d0baa064dd556b249de92809_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/.gitlab-ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":57,"endLine":4,"snippet":{"text":"  - remote: \"https://example.com/ci/templates/build.yml\""},"startColumn":1,"startLine":4}}}],"message":{"text":"The pipeline includes configuration that can change without a change to this repository: a remote URL without an integrity hash, a project file from a branch (or without ref, the default branch), or a CI/CD component at ~latest or a branch. Whoever can change that source can change the jobs and read their secrets. Pin includes to a tag or commit SHA, and add integrity: to remote includes."},"properties":{},"ruleId":"opt.pathos.rules.pathos.cicd.gitlab.unpinned-include"},{"fingerprints":{"matchBasedId/v1":"dcf1c31ed9b79400c2a156bb8e3953c85fcb341eff6a44d505c574607b7478e6b618b2e4b57d0cd8a13af68cc0c1c2a04eeae318d0baa064dd556b249de92809_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/.gitlab-ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":14,"endLine":10,"snippet":{"text":"    ref: main"},"startColumn":1,"startLine":10}}}],"message":{"text":"The pipeline includes configuration that can change without a change to this repository: a remote URL without an integrity hash, a project file from a branch (or without ref, the default branch), or a CI/CD component at ~latest or a branch. Whoever can change that source can change the jobs and read their secrets. Pin includes to a tag or commit SHA, and add integrity: to remote includes."},"properties":{},"ruleId":"opt.pathos.rules.pathos.cicd.gitlab.unpinned-include"},{"fingerprints":{"matchBasedId/v1":"dcf1c31ed9b79400c2a156bb8e3953c85fcb341eff6a44d505c574607b7478e6b618b2e4b57d0cd8a13af68cc0c1c2a04eeae318d0baa064dd556b249de92809_2"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/.gitlab-ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":64,"endLine":17,"snippet":{"text":"  - component: $CI_SERVER_FQDN/platform/components/sast@~latest"},"startColumn":1,"startLine":17}}}],"message":{"text":"The pipeline includes configuration that can change without a change to this repository: a remote URL without an integrity hash, a project file from a branch (or without ref, the default branch), or a CI/CD component at ~latest or a branch. Whoever can change that source can change the jobs and read their secrets. Pin includes to a tag or commit SHA, and add integrity: to remote includes."},"properties":{},"ruleId":"opt.pathos.rules.pathos.cicd.gitlab.unpinned-include"},{"fingerprints":{"matchBasedId/v1":"76e48b96c41d894e91d60e082993b4bf6c36eac9fa00f30bf178552407b69ce03386b990f40dafdff773d716d37935f9dc5505fd9949cf3088a78bd3d5d65d7e_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/.gitlab-ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":12,"endLine":22,"snippet":{"text":"image: node"},"startColumn":1,"startLine":22}}}],"message":{"text":"A pipeline job image has no tag or uses :latest, so every run can get different (and possibly compromised) code with access to the job's secrets. Pin the image to a digest (image: name:tag@sha256:...) or at least to an exact version tag."},"properties":{},"ruleId":"opt.pathos.rules.pathos.cicd.unpinned-container-image"},{"fingerprints":{"matchBasedId/v1":"dcb5f60c6cb5c7ea07585bb3af7cc5e7da5011a711d40af29fb568afdafe9c43c56e82fda1a8c91b087041f8d766025a15649b06c993fe71ed7d460b99d25549_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/.gitlab-ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":25,"endLine":26,"snippet":{"text":"  DOCKER_TLS_CERTDIR: \"\""},"startColumn":1,"startLine":26}}}],"message":{"text":"A job runs privileged containers, mounts the Docker socket, or runs Docker-in-Docker without TLS (DOCKER_TLS_CERTDIR: \"\"). Code in the job (including dependencies and test code) can then take over the runner host and every other job on it. Use rootless builders (BuildKit rootless, Kaniko, Buildah) or dedicated, isolated runners."},"properties":{},"ruleId":"opt.pathos.rules.pathos.cicd.privileged-docker"},{"fingerprints":{"matchBasedId/v1":"16d3efadfc0d8e0cfa542532ea483134a7aff766f84ce5e099898ca8ca9744e7a18a51a3aea2502988c8c47f0a9b3f0b16afaeb0211a0801055af8f4c0de1e54_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/.gitlab-ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":37,"endLine":35,"snippet":{"text":"    - git checkout $CI_COMMIT_BRANCH"},"startColumn":1,"startLine":35}}}],"message":{"text":"A GitLab CI script uses a variable that the author of a commit, branch, tag or merge request controls (commit message, branch or tag name, merge request title or description) in eval, sh -c / bash -c, or unquoted. Shell metacharacters in that value then run as commands, or the value splits into extra arguments (argument injection). Quote the variable (\"$CI_COMMIT_BRANCH\") and never pass it to eval or a nested shell."},"properties":{},"ruleId":"opt.pathos.rules.pathos.cicd.gitlab.script-injection"},{"fingerprints":{"matchBasedId/v1":"16d3efadfc0d8e0cfa542532ea483134a7aff766f84ce5e099898ca8ca9744e7a18a51a3aea2502988c8c47f0a9b3f0b16afaeb0211a0801055af8f4c0de1e54_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/.gitlab-ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":41,"endLine":37,"snippet":{"text":"    - eval \"echo $CI_MERGE_REQUEST_TITLE\""},"startColumn":1,"startLine":37}}}],"message":{"text":"A GitLab CI script uses a variable that the author of a commit, branch, tag or merge request controls (commit message, branch or tag name, merge request title or description) in eval, sh -c / bash -c, or unquoted. Shell metacharacters in that value then run as commands, or the value splits into extra arguments (argument injection). Quote the variable (\"$CI_COMMIT_BRANCH\") and never pass it to eval or a nested shell."},"properties":{},"ruleId":"opt.pathos.rules.pathos.cicd.gitlab.script-injection"},{"fingerprints":{"matchBasedId/v1":"6dae3077b880a669a214e3138de8ac37358499e4cf1789b961cc79aa2478c7fe822ab465264c90fb40df716ea17b3d85ebccea85d43608a183aad503b5d0a398_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/.gitlab-ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":55,"endLine":39,"snippet":{"text":"    - curl -fsSL https://example.com/install.sh | bash"},"startColumn":7,"startLine":39}}}],"message":{"text":"The pipeline downloads a script and runs it in a shell in one step (curl ... | sh). Whoever controls the server, the DNS or the network path at that moment controls the code that runs in the job, with its secrets. Download a pinned version, verify its checksum or signature, then run it."},"properties":{},"ruleId":"opt.pathos.rules.pathos.cicd.curl-pipe-shell"},{"fingerprints":{"matchBasedId/v1":"c5e9ef57db83b6e5ad6e350e05d038bd1f1e640d0d8c1b48b35d5117bfab515e697f0252c96f8566c8456b030b5c71a40c4cec630d1fed008878d5a012310bc8_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/.gitlab-ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":42,"endLine":43,"snippet":{"text":"    - echo \"deploy token is $DEPLOY_TOKEN\""},"startColumn":7,"startLine":43}}}],"message":{"text":"A pipeline script writes a variable whose name says it is a secret (token, password, key, credential) to the job log, or prints the whole environment. Masking works only for registered secret values and not for encoded or partial forms, and job logs are readable by many users. Do not print secrets; pass them to tools through stdin or files."},"properties":{},"ruleId":"opt.pathos.rules.pathos.cicd.secret-echoed"},{"fingerprints":{"matchBasedId/v1":"c5e9ef57db83b6e5ad6e350e05d038bd1f1e640d0d8c1b48b35d5117bfab515e697f0252c96f8566c8456b030b5c71a40c4cec630d1fed008878d5a012310bc8_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/.gitlab-ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":15,"endLine":47,"snippet":{"text":"    - printenv"},"startColumn":1,"startLine":47}}}],"message":{"text":"A pipeline script writes a variable whose name says it is a secret (token, password, key, credential) to the job log, or prints the whole environment. Masking works only for registered secret values and not for encoded or partial forms, and job logs are readable by many users. Do not print secrets; pass them to tools through stdin or files."},"properties":{},"ruleId":"opt.pathos.rules.pathos.cicd.secret-echoed"},{"fingerprints":{"matchBasedId/v1":"76e48b96c41d894e91d60e082993b4bf6c36eac9fa00f30bf178552407b69ce03386b990f40dafdff773d716d37935f9dc5505fd9949cf3088a78bd3d5d65d7e_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/.gitlab-ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":23,"endLine":51,"snippet":{"text":"  image: docker:latest"},"startColumn":1,"startLine":51}}}],"message":{"text":"A pipeline job image has no tag or uses :latest, so every run can get different (and possibly compromised) code with access to the job's secrets. Pin the image to a digest (image: name:tag@sha256:...) or at least to an exact version tag."},"properties":{},"ruleId":"opt.pathos.rules.pathos.cicd.unpinned-container-image"},{"fingerprints":{"matchBasedId/v1":"dcb5f60c6cb5c7ea07585bb3af7cc5e7da5011a711d40af29fb568afdafe9c43c56e82fda1a8c91b087041f8d766025a15649b06c993fe71ed7d460b99d25549_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/.gitlab-ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":30,"endLine":56,"snippet":{"text":"    - docker run --privileged -v \"$PWD