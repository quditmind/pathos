ding dependencies and test code) can then take over the runner host and every other job on it. Use rootless builders (BuildKit rootless, Kaniko, Buildah) or dedicated, isolated runners."},"properties":{},"ruleId":"opt.pathos.rules.pathos.cicd.privileged-docker"},{"fingerprints":{"matchBasedId/v1":"b553bad5888fd3a54d3e40bfbd536546caa27dda65636b9d969c1a10cbf52599f634d6d766f000e03d09cb785cfb04589480da1ad7baaff245f2dfcb342465d1_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/crypto.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":26,"endLine":21,"snippet":{"text":"    a = hashlib.md5(data).hexdigest()"},"startColumn":9,"startLine":21}}}],"message":{"text":"MD5 or SHA-1 is used. Both have practical collision attacks and must not protect integrity, signatures or passwords; use SHA-256 or better (and a password hash such as Argon2, scrypt or bcrypt for passwords). Pass usedforsecurity=False when the hash is not used for security."},"properties":{},"ruleId":"opt.pathos.rules.pathos.crypto.python.weak-hash"},{"fingerprints":{"matchBasedId/v1":"b553bad5888fd3a54d3e40bfbd536546caa27dda65636b9d969c1a10cbf52599f634d6d766f000e03d09cb785cfb04589480da1ad7baaff245f2dfcb342465d1_1"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"/work/fixture/src/crypto.py","uriBaseId":"%SRCROOT%"},"region":{"endColumn":34,"endLine":23,"snippet":{"text":"    b = hashlib.new(\"sha1\", data)"},"startColumn":9,"startLine":23}}}],"message":{"text":"MD5 or SHA-1 is used. Both have practical collision attacks and must not protect integrity, signatures or passwords; use SHA-256 or better (and a password hash such as Argon2, scrypt or bcrypt for passwords). Pass usedforsecurity=False when the hash is not used for security."},"properties":{},"ruleId":"opt.pathos.rules.pathos.crypto.python.weak-hash"},{"fingerprints":{"matchBasedId/v1":"b553bad5888fd3a54d3e40bfbd536546caa27dda65636b9d969c1a10cbf52599f634d6d766f000e03d09cb785cfb04589480da1ad7baaff245f2dfcb34246