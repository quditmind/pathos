{
	admin off
	# Clients that send no SNI (some Java/TLS libraries for dot-less hosts,
	# health probes by IP) get the site certificate instead of a TLS alert.
	default_sni {$PATHOS_DOMAIN:localhost}
	# No trusted_proxies: Caddy discards client-supplied X-Forwarded-* headers
	# and sets its own, so the API can trust the rightmost X-Forwarded-For.
}

{$PATHOS_DOMAIN:localhost} {
	# "internal" uses Caddy's local CA (development / private networks).
	# Set CADDY_TLS to an email address to obtain a public ACME certificate.
	tls {$CADDY_TLS:internal}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	# PATHOS MCP server (personal API token authentication).
	handle /mcp {
		reverse_proxy api:8080
	}

	# Health endpoints and the internal worker API are never exposed.
	handle /healthz {
		respond 404
	}
	handle /internal/* {
		respond 404
	}

	# The Keycloak admin console, admin REST API and master realm are only
	# reachable from KEYCLOAK_ADMIN_ALLOW (default: private networks, which
	# includes localhost through Docker). PATHOS itself talks to Keycloak on
	# the internal network and is unaffected.
	@kcadmin {
		path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/*
		not client_ip {$KEYCLOAK_ADMIN_ALLOW:private_ranges}
	}
	handle @kcadmin {
		respond 404
	}

	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	handle {
		root * /srv
		header {
			# Scripts are strictly 'self'. Inline styles are allowed because the
			# Radix scroll lock injects a <style> element with runtime values
			# (no stable hash); inline CSS cannot execute code.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			X-Frame-Options "DENY"
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Embedder-Policy "require-corp"
			Cross-Origin-Resource-Policy "same-origin"
		}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
