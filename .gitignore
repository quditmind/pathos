# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
/secrets/

# Build output
/backend/bin/
/frontend/dist/
node_modules/
coverage/
*.test
*.out

# Local data
/data/
/backups/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Toolchain caches (scripts/go.sh, scripts/npm.sh use ~/.cache by default)
frontend/node_modules/

# Generated caches
__pycache__/
*.tsbuildinfo

# Generated reports (security scans, load tests)
/reports/

# Browser tests
e2e/node_modules/
e2e/.auth/
e2e/test-results/
e2e/playwright-report/
/.sandbox-e2e-*/
